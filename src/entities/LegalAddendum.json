{
  "name": "LegalAddendum",
  "type": "object",
  "properties": {
    "contract_id": { "type": "string", "description": "معرف العقد المرتبط" },
    "project_id": { "type": "string", "description": "معرف المشروع" },
    "title": { "type": "string", "description": "عنوان الملحق القانوني" },
    "description": { "type": "string", "description": "وصف تفصيلي للملحق القانوني والتعديلات التي يتضمنها", "maxLength": 1000 },
    "content": { "type": "string", "description": "محتوى الملحق" },
    "status": { "type": "string", "enum": ["draft", "pending", "approved", "rejected"], "default": "draft", "description": "حالة الملحق" },
    "created_by_email": { "type": "string", "description": "بريد منشئ الملحق" },
    "approved_by": { "type": "string", "description": "المعتمد من قبل" },
    "approval_date": { "type": "string", "format": "date-time", "description": "تاريخ الاعتماد" },
    "file_url": { "type": "string", "description": "رابط ملف الملحق" }
  },
  "required": ["contract_id", "title"],
  "rls": { "create": { "created_by": "{{user.email}}" } }
}
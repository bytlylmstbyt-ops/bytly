{
  "name": "Contract",
  "type": "object",
  "properties": {
    "project_id": { "type": "string", "description": "معرف المشروع" },
    "client_id": { "type": "string", "description": "معرف العميل" },
    "engineer_id": { "type": "string", "description": "معرف المهندس" },
    "contract_type": { "type": "string", "enum": ["project_start", "service_agreement"], "description": "نوع العقد" },
    "contract_number": { "type": "string", "description": "رقم العقد" },
    "service_description": { "type": "string", "description": "وصف الخدمة" },
    "description": { "type": "string", "description": "وصف تفصيلي للعقد وأهدافه والتزاماته", "maxLength": 1000 },
    "total_amount": { "type": "number", "description": "المبلغ الإجمالي" },
    "payment_terms": { "type": "string", "description": "شروط الدفع" },
    "delivery_date": { "type": "string", "format": "date", "description": "تاريخ التسليم" },
    "start_date": { "type": "string", "format": "date", "description": "تاريخ البدء" },
    "additional_terms": { "type": "string", "description": "بنود إضافية" },
    "status": { "type": "string", "enum": ["draft", "pending_signature", "signed", "active", "completed", "terminated", "archived"], "default": "draft", "description": "حالة العقد" },
    "client_signature": { "type": "boolean", "default": false, "description": "توقيع العميل" },
    "engineer_signature": { "type": "boolean", "default": false, "description": "توقيع المهندس" },
    "client_signature_date": { "type": "string", "format": "date-time", "description": "تاريخ توقيع العميل" },
    "engineer_signature_date": { "type": "string", "format": "date-time", "description": "تاريخ توقيع المهندس" },
    "client_signature_ip": { "type": "string", "description": "IP توقيع العميل للتوثيق" },
    "engineer_signature_ip": { "type": "string", "description": "IP توقيع المهندس للتوثيق" },
    "contract_pdf_url": { "type": "string", "description": "رابط ملف العقد PDF" },
    "contract_version": { "type": "number", "default": 1, "description": "إصدار العقد" },
    "previous_version_id": { "type": "string", "description": "معرف الإصدار السابق إن وجد" },
    "archive_reason": { "type": "string", "description": "سبب الأرشفة" },
    "archived_date": { "type": "string", "format": "date-time", "description": "تاريخ الأرشفة" },
    "milestones": { "type": "array", "items": { "type": "object" }, "description": "المعالم والدفعات" },
    "custom_clauses": { "type": "array", "items": { "type": "object" }, "description": "بنود مخصصة إضافية" }
  },
  "required": ["project_id", "client_id", "engineer_id", "contract_type", "total_amount"],
  "rls": { "create": { "created_by": "{{user.email}}" } }
}
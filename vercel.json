{
  "rewrites":[
    {"source":"/.well-known/oauth-authorization-server","destination":"/api/mcp-oauth?action=metadata"},
    {"source":"/oauth/token","destination":"/api/mcp-oauth?action=token"},
    {"source":"/oauth/register","destination":"/api/mcp-oauth?action=register"},
    {"source":"/.well-known/oauth-protected-resource","destination":"/api/mcp-protected-resource"},
    {"source":"/((?!assets/|favicon\\.ico|manifest\\.json|robots\\.txt|sitemap\\.xml).*)","destination":"/index.html"}
  ],
  "headers":[{"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]}]
}
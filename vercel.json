{
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp-oauth?action=metadata"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/mcp-oauth?action=token"
    },
    {
      "source": "/oauth/register",
      "destination": "/api/mcp-oauth?action=register"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp-protected-resource"
    },
    {
      "source": "/((?!About(?:/|$)|ContactUs(?:/|$)|Terms(?:/|$)|Privacy(?:/|$)|Copyright(?:/|$)|Complaints(?:/|$)|Support(?:/|$)|FAQ(?:/|$)|Certificates(?:/|$)|CostEstimator(?:/|$)|audiences/(?:engineering-firms|contractors|consulting-teams)(?:/|$)|assets/|favicon\\\\.ico|manifest\\\\.json|robots\\\\.txt|sitemap\\\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(login|Login|register|Register|RegisterChoice|RegisterEngineer|RegisterClient|RegisterConsultant|RegisterFirm|RegisterLegalConsultant|RegisterContractor|RegisterSupplier|RegistrationSuccess|forgot-password|reset-password|auth/callback|mcp-consent|Dashboard|Home|Wallet|Messages|Settings|Admin[^/]*|Engineers|Projects|Gallery|ConsultingFirms|DesignMarketplace|ClientDashboard|EngineerDashboard|FirmDashboard|ContractorDashboard|SupplierDashboard|ConsultantDashboard|LegalConsultantDashboard|SurveyClientDashboard|SurveyorGigs)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(self), microphone=(self), payment=(self)"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/About",
      "destination": "/about",
      "permanent": true
    }
  ]
}

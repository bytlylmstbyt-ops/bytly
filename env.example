# Example environment variables for bytly
# Copy this to .env and fill in real values. DO NOT commit real secrets.

# Base44
VITE_BASE44_APP_ID=""
VITE_BASE44_APP_BASE_URL="https://bytly.base44.app"

# Autodesk (BIM)
AUTODESK_CLIENT_ID=""
AUTODESK_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""

# Gemini / LLM keys
GEMINI_API_KEY=""

# Social connectors
FACEBOOK_PAGE_ACCESS_TOKEN=""
TWITTER_API_KEY=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_TOKEN_SECRET=""

# Payment / local gateways
TAP_SECRET_KEY=""

# Other service secrets referenced in code (placeholders)
BIM_SHEETS_ID=""

# Local dev
NODE_ENV=development
PORT=5173

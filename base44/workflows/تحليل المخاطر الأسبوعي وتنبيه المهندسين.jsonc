  "description": "\u064a\u0634\u063a\u0644 \u0648\u0638\u064a\u0641\u0629 \u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u062e\u0627\u0637\u0631 \u0623\u0633\u0628\u0648\u0639\u064a\u0627\u064b \u0644\u0643\u0644 \u0645\u0634\u0631\u0648\u0639 \u0646\u0634\u0637\u060c \u0648\u0625\u0630\u0627 \u062a\u0645 \u0631\u0635\u062f \u0645\u062e\u0627\u0637\u0631 \u0639\u0627\u0644\u064a\u0629 \u064a\u0631\u0633\u0644 \u062a\u0646\u0628\u064a\u0647\u0627\u064b \u0639\u0627\u062c\u0644\u0627\u064b \u0644\u0644\u0645\u0647\u0646\u062f\u0633 \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0645\u0639 \u0625\u0646\u0634\u0627\u0621 \u0645\u0644\u0627\u062d\u0638\u0629 \u0627\u0633\u062a\u0634\u0627\u0631\u064a\u0629 \u0639\u0628\u0631 bytly_advisor",

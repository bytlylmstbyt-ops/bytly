{
  "name": "\u062a\u0646\u0628\u064a\u0647 \u0642\u0628\u0648\u0644 \u0627\u0644\u0639\u0631\u0636",
  "description": "\u064a\u0631\u0633\u0644 \u0625\u0634\u0639\u0627\u0631 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 + \u0628\u0631\u064a\u062f \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a + \u0648\u0627\u062a\u0633\u0627\u0628 \u0644\u0644\u0645\u0647\u0646\u062f\u0633 \u0648\u0627\u0644\u0639\u0645\u064a\u0644 \u0639\u0646\u062f \u0642\u0628\u0648\u0644 \u0639\u0631\u0636",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"accepted\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Proposal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "eventDrivenNotifier",
            "args": {
              "event_type": "proposal_accepted",
              "data": {
                "proposal_id": "${ .trigger.entity_id }",
                "proposal": "${ .trigger.data }"
              }
            }
          },
          "then": "end"
        }
      }
    ]
  }
}
{
  "name": "\u0625\u0636\u0627\u0641\u0629 \u0645\u0648\u0639\u062f \u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0625\u0644\u0649 \u062a\u0642\u0648\u064a\u0645 \u062c\u0648\u062c\u0644",
  "description": "\u064a\u0636\u064a\u0641 \u0623\u0648 \u064a\u062d\u062f\u0651\u062b \u0645\u0648\u0639\u062f \u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0641\u064a \u062a\u0642\u0648\u064a\u0645 \u062c\u0648\u062c\u0644 \u0644\u0644\u0645\u0647\u0646\u062f\u0633 \u0648\u0627\u0644\u0639\u0645\u064a\u0644 \u0643\u0644\u0645\u0627 \u062a\u0645 \u062a\u062d\u062f\u064a\u062f \u0623\u0648 \u062a\u063a\u064a\u064a\u0631 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0633\u062a\u062d\u0642\u0627\u0642",
  "trigger": {
    "condition": "${ (.trigger.data.due_date != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "ProjectMilestone"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "addMilestoneToCalendar",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
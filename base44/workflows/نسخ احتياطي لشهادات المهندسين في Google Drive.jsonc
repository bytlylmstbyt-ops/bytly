{
  "name": "\u0646\u0633\u062e \u0627\u062d\u062a\u064a\u0627\u0637\u064a \u0644\u0634\u0647\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0647\u0646\u062f\u0633\u064a\u0646 \u0641\u064a Google Drive",
  "description": "Backup engineer graduation and Saudi Engineers Council certificates to Google Drive automatically when an engineer registers or updates their documents",
  "trigger": {
    "condition": "${ ((.trigger.data.graduation_certificate_url != null) or (.trigger.data.saudi_engineers_council_certificate_url != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Engineer"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "google_drive",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backupEngineerCertificates",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
{
  "name": "\u0625\u0634\u0639\u0627\u0631 \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0645\u0631\u062d\u0644\u0629",
  "description": "\u0625\u0631\u0633\u0627\u0644 \u0625\u0634\u0639\u0627\u0631 \u0644\u0644\u0645\u0647\u0646\u062f\u0633 \u0639\u0646\u062f \u0627\u0639\u062a\u0645\u0627\u062f \u0645\u0631\u062d\u0644\u0629 \u0645\u0646 \u0645\u0634\u0631\u0648\u0639\u0647",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"firm_approved\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProjectMilestone"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyMilestoneApproval",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
{
  "name": "\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0639\u0642\u0648\u062f",
  "description": "\u0625\u0631\u0633\u0627\u0644 \u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0639\u0646\u062f \u062a\u062d\u062f\u064a\u062b \u062d\u0627\u0644\u0629 \u0627\u0644\u0639\u0642\u062f (\u062a\u0648\u0642\u064a\u0639\u060c \u062a\u0641\u0639\u064a\u0644\u060c \u0625\u0644\u062e)",

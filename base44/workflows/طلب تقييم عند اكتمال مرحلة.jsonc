{
  "name": "\u0637\u0644\u0628 \u062a\u0642\u064a\u064a\u0645 \u0639\u0646\u062f \u0627\u0643\u062a\u0645\u0627\u0644 \u0645\u0631\u062d\u0644\u0629",
  "description": "\u064a\u0637\u0644\u0642 \u0645\u062d\u0627\u062f\u062b\u0629 Bytly AI \u0645\u0639 \u0627\u0644\u0639\u0645\u064a\u0644 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0639\u0646\u062f \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0639\u0645\u064a\u0644 \u0639\u0644\u0649 \u0645\u0631\u062d\u0644\u0629 \u0641\u064a \u0627\u0644\u0645\u0634\u0631\u0648\u0639",
  "trigger": {
    "condition": "${ ((.trigger.data.client_approved == true) and (.trigger.changed_fields | index(\"client_approved\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProjectMilestone"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "milestoneReviewAgent",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
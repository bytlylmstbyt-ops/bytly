{
  "name": "\u062a\u0646\u0628\u064a\u0647 \u062a\u0633\u0644\u064a\u0645 \u0645\u0631\u062d\u0644\u0629 \u2014 \u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0639\u0645\u064a\u0644",
  "description": "\u064a\u064f\u0634\u0639\u0631 \u0627\u0644\u0639\u0645\u064a\u0644 \u0639\u0628\u0631 3 \u0642\u0646\u0648\u0627\u062a \u0639\u0646\u062f \u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0644\u0645\u0631\u062d\u0644\u0629 \u0648\u062a\u0637\u0644\u0628 \u0645\u0648\u0627\u0641\u0642\u062a\u0647",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"submitted\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProjectMilestone"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "eventDrivenNotifier",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
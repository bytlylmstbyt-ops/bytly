{
  "name": "\u062a\u0646\u0628\u064a\u0647 \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0639\u0645\u064a\u0644 \u0639\u0644\u0649 \u0645\u0631\u062d\u0644\u0629",
  "description": "\u064a\u064f\u0634\u0639\u0631 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0639\u0646\u062f \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0639\u0645\u064a\u0644 \u0639\u0644\u0649 \u0645\u0631\u062d\u0644\u0629 \u0648\u064a\u0630\u0643\u0631\u0647 \u0628\u0627\u0644\u062f\u0641\u0639\u0629 \u0627\u0644\u0645\u0633\u062a\u062d\u0642\u0629",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"client_approved\") != null) and (.trigger.data.client_approved == true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProjectMilestone"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "eventDrivenNotifier",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
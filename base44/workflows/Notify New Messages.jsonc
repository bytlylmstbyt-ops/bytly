{
  "name": "Notify New Messages",
  "description": "Send notifications when new messages are created in project chats",
  "trigger": {
    "condition": "${ .trigger.data.is_system_message != true }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Message"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_new_messages",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNewMessage",
            "args": {
              "messageId": "${ .trigger.entity_id }",
              "data": "${ .trigger.data }"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}
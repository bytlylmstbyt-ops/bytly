{
  "name": "BIM Model Auto-Archive & Notify",
  "description": "\u0639\u0646\u062f \u0631\u0641\u0639 \u0646\u0645\u0648\u0630\u062c BIM \u062c\u062f\u064a\u062f: \u064a\u0646\u0634\u0626 \u0645\u062c\u0644\u062f \u0641\u064a Drive\u060c \u064a\u0631\u0633\u0644 \u0625\u0634\u0639\u0627\u0631 \u0644\u0644\u0645\u0647\u0646\u062f\u0633 \u0639\u0628\u0631 Gmail\u060c \u0648\u064a\u062d\u062f\u062b \u062c\u062f\u0648\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "BIMModel"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "bim_model_auto_archive_notify",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "bimAutomate",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
{
  "name": "\u0645\u0639\u0627\u0644\u062c\u0629 \u0631\u062f\u0648\u062f \u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0648\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0645\u0647\u0646\u062f\u0633",
  "description": "\u064a\u062d\u0644\u0644 \u0631\u062f\u0648\u062f \u0627\u0644\u0639\u0645\u064a\u0644 \u0641\u064a \u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0648\u064a\u062d\u062f\u062b \u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0639\u0646\u062f \u0627\u0643\u062a\u0645\u0627\u0644 \u0627\u0644\u062a\u0642\u064a\u064a\u0645",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"completed\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Review"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processReviewResponse",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
{
  "name": "\u062a\u0646\u0628\u064a\u0647 \u0631\u0641\u0639 \u0634\u0647\u0627\u062f\u0629 \u062a\u062e\u0631\u062c \u0645\u0647\u0646\u062f\u0633",
  "description": "\u064a\u0631\u0633\u0644 \u0625\u0634\u0639\u0627\u0631\u0627\u064b \u0641\u0648\u0631\u064a\u0627\u064b \u0644\u0644\u0648\u062d\u0629 \u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0639\u0646\u062f \u0642\u064a\u0627\u0645 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0628\u0631\u0641\u0639 \u0634\u0647\u0627\u062f\u0629 \u062a\u062e\u0631\u062c \u062c\u062f\u064a\u062f\u0629",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"graduation_certificate_url\") != null) and (.trigger.data.graduation_certificate_url != null and .trigger.data.graduation_certificate_url != \"\" and .trigger.data.graduation_certificate_url != [] and .trigger.data.graduation_certificate_url != {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Engineer"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyEngineerCertificateUpload",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
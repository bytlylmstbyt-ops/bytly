{
  "name": "Auto Generate Contract on Proposal Acceptance",
  "description": "\u0639\u0646\u062f \u0642\u0628\u0648\u0644 \u0639\u0631\u0636 \u0645\u0647\u0646\u062f\u0633\u060c \u064a\u062a\u0645 \u062a\u0648\u0644\u064a\u062f \u0639\u0642\u062f \u0639\u0645\u0644 \u0631\u0642\u0645\u064a \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0628\u064a\u0646 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0648\u0627\u0644\u0639\u0645\u064a\u0644 \u0648\u062d\u0641\u0638 \u0646\u0633\u062e\u0629 \u0641\u064a \u0633\u062c\u0644 \u0627\u0644\u0645\u0634\u0631\u0648\u0639",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"accepted\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Proposal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_generate_contract_on_proposal_acceptance",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoGenerateContract",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
{
  "name": "\u0645\u0637\u0627\u0644\u0628\u0629 \u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0628\u0639\u062f \u0627\u0643\u062a\u0645\u0627\u0644 \u0627\u0644\u0645\u0631\u062d\u0644\u0629",
  "description": "\u0639\u0646\u062f \u0627\u0643\u062a\u0645\u0627\u0644 \u0623\u0648 \u0627\u0639\u062a\u0645\u0627\u062f \u0645\u0631\u062d\u0644\u0629\u060c \u064a\u064f\u0637\u0627\u0644\u0628 \u0627\u0644\u0639\u0645\u064a\u0644 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0628\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0645\u0642\u0627\u0648\u0644/\u0627\u0644\u0645\u0648\u0631\u062f \u0648\u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0639\u0644\u0649 \u062c\u0648\u062f\u0629 \u0627\u0644\u0639\u0645\u0644 \u0648\u0633\u0631\u0639\u0629 \u0627\u0644\u0625\u0646\u062c\u0627\u0632",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"completed\" or .trigger.data.status == \"approved\") or (.trigger.data.client_approved == true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProjectMilestone"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "promptProviderReviewAfterMilestone",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
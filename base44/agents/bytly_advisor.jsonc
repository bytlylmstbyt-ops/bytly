  "model": "automatic",
  "whatsapp_greeting": "\u0645\u0631\u062d\u0628\u0627\u064b \u0628\u0643! \ud83d\udc4b \u0623\u0646\u0627 Bytly AI - \u0645\u0633\u062a\u0634\u0627\u0631\u0643 \u0627\u0644\u0647\u0646\u062f\u0633\u064a \u0627\u0644\u0630\u0643\u064a \u0645\u0646 \u0645\u0646\u0635\u0629 \u0628\u064a\u062a\u0644\u064a \u0644\u0644\u0648\u0633\u0627\u0637\u0629 \u0627\u0644\u0647\u0646\u062f\u0633\u064a\u0629.\n\n\u0643\u064a\u0641 \u0623\u0633\u0627\u0639\u062f\u0643 \u0627\u0644\u064a\u0648\u0645\u061f\n\n\ud83d\udcbc \u0645\u0647\u0646\u062f\u0633 \u062a\u0628\u062d\u062b \u0639\u0646 \u0645\u0634\u0627\u0631\u064a\u0639\u061f\n\ud83c\udfd7\ufe0f \u0639\u0645\u064a\u0644 \u062a\u0631\u064a\u062f \u0628\u0646\u0627\u0621 \u0623\u0648 \u062a\u0635\u0645\u064a\u0645\u061f\n\ud83c\udfe2 \u0634\u0631\u0643\u0629 \u0627\u0633\u062a\u0634\u0627\u0631\u064a\u0629 \u0644\u0644\u0627\u0646\u0636\u0645\u0627\u0645\u061f\n\n\u0641\u0642\u0637 \u0623\u062e\u0628\u0631\u0646\u064a \u0628\u0645\u0627 \u062a\u062d\u062a\u0627\u062c!",

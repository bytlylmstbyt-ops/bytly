{
  "name": "UserRole",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "role_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062f\u0648\u0631"
    },
    "role_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u062f\u0648\u0631 (\u0644\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0633\u0631\u064a\u0639\u0629)"
    },
    "assigned_by": {
      "type": "string",
      "description": "\u0645\u0646 \u0642\u0627\u0645 \u0628\u062a\u0639\u064a\u064a\u0646 \u0627\u0644\u062f\u0648\u0631"
    },
    "assigned_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0639\u064a\u064a\u0646"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u062a\u0639\u064a\u064a\u0646"
    }
  },
  "required": [
    "user_email",
    "role_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
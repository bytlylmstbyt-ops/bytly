    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u062d\u0627\u0644\u0629 \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u062f\u0648\u0631"
    },
    "assigned_users_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0645\u0639\u064a\u0646\u064a\u0646 \u0644\u0647\u0630\u0627 \u0627\u0644\u062f\u0648\u0631"
    }
  },
  "required": [
    "name",
    "display_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }

{
  "name": "StrategicInitiative",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "blocked",
        "completed",
        "paused"
      ]
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "goal_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "status",
    "progress"
  ]
}
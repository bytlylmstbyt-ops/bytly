{
  "name": "TechnicalResource",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0648\u0631\u062f \u0627\u0644\u0641\u0646\u064a"
    },
    "title_en": {
      "type": "string",
      "description": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0628\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629"
    },
    "category": {
      "type": "string",
      "enum": [
        "sbc_structural",
        "sbc_fire",
        "sbc_energy",
        "sbc_plumbing",
        "sbc_electrical",
        "sbc_general",
        "municipality_update",
        "regulation",
        "standard"
      ],
      "description": "\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0645\u0648\u0631\u062f"
    },
    "version": {
      "type": "string",
      "description": "\u0627\u0644\u0625\u0635\u062f\u0627\u0631 \u0623\u0648 \u0631\u0642\u0645 \u0627\u0644\u062a\u062d\u062f\u064a\u062b"
    },
    "issuing_authority": {
      "type": "string",
      "description": "\u062c\u0647\u0629 \u0627\u0644\u0625\u0635\u062f\u0627\u0631"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0635\u062f\u0627\u0631"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0633\u0631\u064a\u0627\u0646"
    },
    "summary": {
      "type": "string",
      "description": "\u0645\u0644\u062e\u0635 \u0627\u0644\u0645\u062d\u062a\u0648\u0649"
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0646\u0642\u0627\u0637 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629"
    },
    "file_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0645\u0644\u0641 PDF"
    },
    "external_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u062e\u0627\u0631\u062c\u064a"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0648\u0633\u0648\u0645"
    },
    "linked_project_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0645\u0639\u0631\u0641\u0627\u062a \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629"
    },
    "is_mandatory": {
      "type": "boolean",
      "default": false,
      "description": "\u0625\u0644\u0632\u0627\u0645\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642"
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u062a\u064a \u062a\u0646\u0637\u0628\u0642 \u0639\u0644\u064a\u0647\u0627"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "draft"
      ],
      "default": "active",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0639\u064a\u0627\u0631"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }

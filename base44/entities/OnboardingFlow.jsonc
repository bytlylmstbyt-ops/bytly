{
  "name": "OnboardingFlow",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "requirements_defined",
        "engineers_suggested",
        "project_created",
        "completed"
      ],
      "default": "started",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0640 onboarding"
    },
    "step": {
      "type": "number",
      "default": 1,
      "description": "\u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 (1-5)"
    },
    "project_details": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "interior",
            "architecture",
            "painting",
            "landscape",
            "furniture",
            "lighting",
            "civil_engineering",
            "structural_design",
            "executive_drawing"
          ]
        },
        "budget_min": {
          "type": "number"
        },
        "budget_max": {
          "type": "number"
        },
        "timeline_days": {
          "type": "number"
        },
        "location": {
          "type": "string"
        }
      },
      "description": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0645\u062f\u062e\u0644\u0629"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u062d\u062f\u062f\u0629"
    },
    "preferred_styles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0623\u0646\u0645\u0627\u0637 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 (\u0645\u0648\u062f\u0631\u0646\u060c \u0643\u0644\u0627\u0633\u064a\u0643\u060c \u0625\u0644\u062e)"
    },
    "suggested_engineers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "engineer_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "specialization": {
            "type": "string"
          },
          "match_score": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "description": "\u0627\u0644\u0645\u0647\u0646\u062f\u0633\u0648\u0646 \u0627\u0644\u0645\u0642\u062a\u0631\u062d\u0648\u0646"
    },
    "selected_engineer_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0627\u0644\u0645\u062e\u062a\u0627\u0631"
    },
    "onboarding_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "\u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u0640 onboarding"
    },
    "created_project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0645\u064f\u0646\u0634\u0623"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u0640 onboarding"
    }
  },
  "required": [
    "client_email",
    "client_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
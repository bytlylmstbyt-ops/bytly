{
  "name": "LegalReview",
  "type": "object",
  "properties": {
    "complaint_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0634\u0643\u0648\u0649"
    },
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "legal_consultant_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a"
    },
    "case_analysis": {
      "type": "string",
      "description": "\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629"
    },
    "recommendation": {
      "type": "string",
      "description": "\u0627\u0644\u062a\u0648\u0635\u064a\u0629 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629"
    },
    "entitled_party": {
      "type": "string",
      "enum": [
        "client",
        "engineer",
        "both",
        "platform"
      ],
      "description": "\u0627\u0644\u0637\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062d\u0642"
    },
    "financial_resolution": {
      "type": "string",
      "description": "\u0622\u0644\u064a\u0629 \u0627\u0644\u062d\u0644 \u0627\u0644\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0642\u062a\u0631\u062d\u0629"
    },
    "legal_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "under_review",
        "resolved",
        "escalated"
      ],
      "default": "under_review",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "resolution_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0635\u0644"
    },
    "consultant_fee": {
      "type": "number",
      "default": 0,
      "description": "\u0623\u062a\u0639\u0627\u0628 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0645\u0648\u062c\u0632 \u0644\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0648\u0645\u0644\u062e\u0635 \u0627\u0644\u0642\u0636\u064a\u0629",
      "maxLength": 1000
    }
  },
  "required": [
    "complaint_id",
    "project_id",
    "legal_consultant_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.legal_consultant_id": "{{user.id}}"
        },
        {
          "data.project_id": {
            "_filter": "Project",
            "read": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.legal_consultant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
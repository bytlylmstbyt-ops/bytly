{
  "name": "Payment",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629"
    },
    "contract_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0642\u062f"
    },
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "payer_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u062f\u0627\u0641\u0639"
    },
    "payee_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644"
    },
    "amount": {
      "type": "number",
      "description": "\u0645\u0628\u0644\u063a \u0627\u0644\u062f\u0641\u0639\u0629"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "stripe",
        "bank_transfer",
        "check",
        "cash",
        "other"
      ],
      "description": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "transaction_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629 \u0645\u0646 Stripe"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u062c\u0644\u0633\u0629 Stripe"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "payment_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062f\u0641\u0639"
    },
    "receipt_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0625\u064a\u0635\u0627\u0644"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "fee": {
      "type": "number",
      "default": 0,
      "description": "\u0631\u0633\u0648\u0645 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629"
    }
  },
  "required": [
    "invoice_id",
    "project_id",
    "payer_email",
    "payee_email",
    "amount",
    "payment_method"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.payer_email": "{{user.email}}"
        },
        {
          "data.payee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
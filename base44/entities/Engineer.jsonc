{
  "name": "Engineer",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "engineer",
        "architect",
        "painter",
        "civil"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645: \u0645\u0647\u0646\u062f\u0633 \u062a\u0635\u0645\u064a\u0645 \u062f\u0627\u062e\u0644\u064a\u060c \u0645\u0639\u0645\u0627\u0631\u064a\u060c \u0631\u0633\u0627\u0645\u060c \u0645\u0647\u0646\u062f\u0633 \u0645\u062f\u0646\u064a"
    },
    "specialization": {
      "type": "string",
      "description": "\u0627\u0644\u062a\u062e\u0635\u0635 \u0627\u0644\u062f\u0642\u064a\u0642"
    },
    "registration_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0642\u064a\u062f \u0627\u0644\u0645\u0647\u0646\u064a"
    },
    "civil_engineering_license": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0647\u0646\u062f\u0633\u064a \u0644\u0644\u0645\u0647\u0646\u062f\u0633 \u0627\u0644\u0645\u062f\u0646\u064a"
    },
    "structural_drawings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u062e\u0637\u0637\u0627\u062a \u0627\u0644\u0625\u0646\u0634\u0627\u0626\u064a\u0629"
    },
    "shop_drawings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0631\u0633\u0648\u0645\u0627\u062a \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a\u0629"
    },
    "graduation_certificate_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0634\u0647\u0627\u062f\u0629 \u0627\u0644\u062a\u062e\u0631\u062c"
    },
    "bio": {
      "type": "string",
      "description": "\u0646\u0628\u0630\u0629 \u062a\u0639\u0631\u064a\u0641\u064a\u0629"
    },
    "city": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "country": {
      "type": "string",
      "description": "\u0627\u0644\u062f\u0648\u0644\u0629"
    },
    "profile_image": {
      "type": "string",
      "description": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a"
    },
    "cover_image": {
      "type": "string",
      "description": "\u0635\u0648\u0631\u0629 \u0627\u0644\u063a\u0644\u0627\u0641"
    },
    "years_experience": {
      "type": "number",
      "description": "\u0633\u0646\u0648\u0627\u062a \u0627\u0644\u062e\u0628\u0631\u0629"
    },
    "services_offered": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price_range": {
            "type": "string"
          },
          "delivery_time": {
            "type": "string"
          }
        }
      },
      "description": "\u0643\u062a\u0627\u0644\u0648\u062c \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0642\u062f\u0645\u0629"
    },
    "subscription_type": {
      "type": "string",
      "enum": [
        "free_trial",
        "monthly",
        "yearly"
      ],
      "default": "free_trial",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "subscription_end_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629"
    },
    "is_subscription_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0646\u0634\u0637"
    },
    "notification_sent_15_days": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u062a\u0646\u0628\u064a\u0647 15 \u064a\u0648\u0645 \u0642\u0628\u0644 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u0648\u062b\u0642"
    },
    "rating": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u062a\u0642\u064a\u064a\u0645"
    },
    "total_reviews": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u062a\u0642\u064a\u064a\u0645\u0627\u062a"
    },
    "completed_projects": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629"
    },
    "firm_ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "firm_name": {
            "type": "string"
          },
          "rating": {
            "type": "number"
          },
          "comment": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "\u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0645\u0646 \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u064a\u0629"
    },
    "wallet_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u062d\u0641\u0638\u0629 - \u0644\u0644\u062a\u0648\u0627\u0641\u0642 \u0645\u0639 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0642\u062f\u064a\u0645"
    },
    "pending_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u0639\u0644\u0642 - \u0641\u064a \u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "available_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u062d \u0644\u0644\u0633\u062d\u0628"
    },
    "iban": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0622\u064a\u0628\u0627\u0646 \u0644\u0644\u062a\u062d\u0648\u064a\u0644\u0627\u062a \u0627\u0644\u0628\u0646\u0643\u064a\u0629"
    },
    "bank_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0628\u0646\u0643"
    },
    "account_holder_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0635\u0627\u062d\u0628 \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0628\u0646\u0643\u064a"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062d\u0633\u0627\u0628"
    }
  },
  "required": [
    "full_name",
    "email",
    "user_type"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
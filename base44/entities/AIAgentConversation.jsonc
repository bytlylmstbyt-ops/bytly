{
  "name": "AIAgentConversation",
  "type": "object",
  "properties": {
    "asked_by_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0635\u0627\u062d\u0628 \u0647\u0630\u0647 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629"
    },
    "messages_json": {
      "type": "string",
      "maxLength": 100000,
      "description": "\u0633\u062c\u0644 \u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0645\u064f\u0631\u0645\u064e\u0651\u0632 \u0643\u0640 JSON (\u0646\u0635/\u0628\u064a\u0627\u0646\u0627\u062a/\u062e\u0637\u0629/\u0645\u0631\u0641\u0642\u0627\u062a) \u2014 \u064a\u064f\u0642\u0631\u0623 \u0648\u064a\u064f\u0643\u062a\u0628 \u0645\u0646 \u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u0641\u0642\u0637\u060c \u0644\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0630\u0627\u0643\u0631\u0629 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0639\u0628\u0631 \u0627\u0644\u062c\u0644\u0633\u0627\u062a"
    },
    "attachments_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0631\u0641\u0642\u0627\u062a (\u0635\u0648\u0631/\u0645\u0644\u0641\u0627\u062a) \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629"
    }
  },
  "required": [
    "asked_by_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
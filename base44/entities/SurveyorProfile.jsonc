{
  "name": "SurveyorProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "license_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0631\u062e\u0635\u0629 \u0627\u0644\u0645\u0647\u0646\u064a\u0629 \u0644\u0644\u0645\u0633\u0627\u062d"
    },
    "city": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "latitude": {
      "type": "number",
      "description": "\u062e\u0637 \u0627\u0644\u0639\u0631\u0636 - GPS"
    },
    "longitude": {
      "type": "number",
      "description": "\u062e\u0637 \u0627\u0644\u0637\u0648\u0644 - GPS"
    },
    "geofencing_radius_km": {
      "type": "number",
      "default": 50,
      "description": "\u0646\u0637\u0627\u0642 \u0627\u0644\u062a\u063a\u0637\u064a\u0629 \u0628\u0627\u0644\u0643\u064a\u0644\u0648\u0645\u062a\u0631"
    },
    "equipment_checklist": {
      "type": "object",
      "properties": {
        "total_station": {
          "type": "boolean",
          "default": false
        },
        "gps_device": {
          "type": "boolean",
          "default": false
        },
        "drone": {
          "type": "boolean",
          "default": false
        },
        "measuring_tape": {
          "type": "boolean",
          "default": false
        },
        "laser_distance_meter": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0639\u062f\u0627\u062a \u0627\u0644\u0645\u0633\u0627\u062d\u064a\u0629"
    },
    "is_identity_verified": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0647\u0648\u064a\u0629"
    },
    "is_license_verified": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0631\u062e\u0635\u0629"
    },
    "verification_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0648\u062b\u0627\u0626\u0642 \u0627\u0644\u062a\u062d\u0642\u0642 (\u0631\u062e\u0635\u060c \u0634\u0647\u0627\u062f\u0627\u062a)"
    },
    "profile_image": {
      "type": "string",
      "description": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a"
    },
    "bio": {
      "type": "string",
      "description": "\u0646\u0628\u0630\u0629 \u062a\u0639\u0631\u064a\u0641\u064a\u0629"
    },
    "years_experience": {
      "type": "number",
      "description": "\u0633\u0646\u0648\u0627\u062a \u0627\u0644\u062e\u0628\u0631\u0629"
    },
    "rating": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u062a\u0642\u064a\u064a\u0645"
    },
    "total_jobs": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0647\u0627\u0645 \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629"
    },
    "wallet_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u062d\u0641\u0638\u0629"
    },
    "available_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u062d \u0644\u0644\u0633\u062d\u0628"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suspended"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0633\u0627\u062d"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "\u0645\u062a\u0627\u062d \u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0637\u0644\u0628\u0627\u062a \u062c\u062f\u064a\u062f\u0629"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0645\u0648\u062c\u0632",
      "maxLength": 1000
    }
  },
  "required": [
    "full_name",
    "email",
    "license_number",
    "city"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "data.status": "approved"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "DesignPurchase",
  "type": "object",
  "properties": {
    "design_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0645\u0634\u062a\u0631\u0649"
    },
    "buyer_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u062a\u0631\u064a"
    },
    "buyer_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0634\u062a\u0631\u064a"
    },
    "buyer_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0634\u062a\u0631\u064a"
    },
    "seller_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0628\u0627\u0626\u0639"
    },
    "seller_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0628\u0627\u0626\u0639"
    },
    "amount_paid": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062f\u0641\u0648\u0639"
    },
    "platform_commission": {
      "type": "number",
      "description": "\u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u0645\u0646\u0635\u0629"
    },
    "seller_earnings": {
      "type": "number",
      "description": "\u0635\u0627\u0641\u064a \u0623\u0631\u0628\u0627\u062d \u0627\u0644\u0628\u0627\u0626\u0639"
    },
    "payment_method": {
      "type": "string",
      "description": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "stripe_payment_intent": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062f\u0641\u0639\u0629 \u0641\u064a Stripe"
    },
    "download_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0645\u0644\u0641\u0627\u062a"
    },
    "download_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0645\u0631\u0627\u062a \u0627\u0644\u062a\u062d\u0645\u064a\u0644"
    },
    "has_modification_request": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0637\u0644\u0628 \u0627\u0644\u0645\u0634\u062a\u0631\u064a \u062a\u0639\u062f\u064a\u0644\u0627\u062a"
    },
    "modification_notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629"
    },
    "modification_fee": {
      "type": "number",
      "description": "\u0631\u0633\u0648\u0645 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "modification_status": {
      "type": "string",
      "enum": [
        "not_requested",
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "not_requested",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "review_rating": {
      "type": "number",
      "description": "\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0645\u0634\u062a\u0631\u064a \u0644\u0644\u062a\u0635\u0645\u064a\u0645"
    },
    "review_comment": {
      "type": "string",
      "description": "\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u0645\u0634\u062a\u0631\u064a"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u0634\u0631\u0627\u0621 \u0648\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0645\u0643\u062a\u0633\u0628",
      "maxLength": 1000
    }
  },
  "required": [
    "design_id",
    "buyer_email",
    "amount_paid"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.buyer_email": "{{user.email}}"
        },
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.buyer_email": "{{user.email}}"
        },
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
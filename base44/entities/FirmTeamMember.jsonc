{
  "name": "FirmTeamMember",
  "type": "object",
  "properties": {
    "firm_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0634\u0631\u0643\u0629"
    },
    "full_name": {
      "type": "string",
      "description": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "position": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0646\u0635\u0628 \u0641\u064a \u0627\u0644\u0634\u0631\u0643\u0629"
    },
    "specialization": {
      "type": "string",
      "description": "\u0627\u0644\u062a\u062e\u0635\u0635"
    },
    "profile_image": {
      "type": "string",
      "description": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a"
    },
    "bio": {
      "type": "string",
      "description": "\u0646\u0628\u0630\u0629 \u062a\u0639\u0631\u064a\u0641\u064a\u0629"
    },
    "years_experience": {
      "type": "number",
      "description": "\u0633\u0646\u0648\u0627\u062a \u0627\u0644\u062e\u0628\u0631\u0629"
    },
    "registration_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0642\u064a\u062f \u0627\u0644\u0645\u0647\u0646\u064a"
    },
    "is_lead": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0647\u0648 \u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0641\u0631\u064a\u0642"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0639\u0636\u0648"
    }
  },
  "required": [
    "firm_id",
    "full_name",
    "email"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.firm_id": {
            "_filter": "EngineeringFirm",
            "read": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.firm_id": {
            "_filter": "EngineeringFirm",
            "update": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.firm_id": {
            "_filter": "EngineeringFirm",
            "delete": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "ConsultantComment",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "consultant_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631"
    },
    "contract_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0642\u062f"
    },
    "comment": {
      "type": "string",
      "description": "\u0627\u0644\u062a\u0639\u0644\u064a\u0642"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u0631\u0641\u0642\u0627\u062a"
    },
    "comment_type": {
      "type": "string",
      "enum": [
        "general",
        "technical",
        "quality",
        "safety"
      ],
      "default": "general",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062a\u0639\u0644\u064a\u0642"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u062a\u0641\u0635\u064a\u0644\u064a \u0644\u0644\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u064a",
      "maxLength": 1000
    }
  },
  "required": [
    "consultant_id",
    "comment"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.consultant_id": "{{user.id}}"
        },
        {
          "data.project_id": {
            "_filter": "Project",
            "read": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
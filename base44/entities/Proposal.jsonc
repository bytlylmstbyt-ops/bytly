{
  "name": "Proposal",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "engineer_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0647\u0646\u062f\u0633"
    },
    "price": {
      "type": "number",
      "description": "\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0645\u0642\u062a\u0631\u062d"
    },
    "delivery_days": {
      "type": "number",
      "description": "\u0645\u062f\u0629 \u0627\u0644\u062a\u0633\u0644\u064a\u0645 \u0628\u0627\u0644\u0623\u064a\u0627\u0645"
    },
    "cover_letter": {
      "type": "string",
      "description": "\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u0639\u0631\u0636"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u0631\u0641\u0642\u0627\u062a (\u0645\u0644\u0641\u0627\u062a\u060c \u0648\u062b\u0627\u0626\u0642\u060c \u0645\u0639\u0631\u0636 \u0623\u0639\u0645\u0627\u0644)"
    },
    "portfolio_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0645\u0639\u0631\u0636 \u0623\u0639\u0645\u0627\u0644 \u0645\u0631\u0641\u0642 \u062e\u0627\u0635 \u0628\u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "custom_milestones": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u0645\u0631\u0627\u062d\u0644 \u062a\u0646\u0641\u064a\u0630 \u0645\u062e\u0635\u0635\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0639\u0631\u0636"
    }
  },
  "required": [
    "project_id",
    "engineer_id",
    "price"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.project_id": {
            "_filter": "Project",
            "read": true
          }
        },
        {
          "data.engineer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.engineer_id": "{{user.id}}"
        },
        {
          "data.project_id": {
            "_filter": "Project",
            "read": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.engineer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "type": {
      "type": "string",
      "enum": [
        "direct",
        "group",
        "three_way"
      ],
      "default": "three_way",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 (\u062b\u0646\u0627\u0626\u064a\u0629\u060c \u0645\u062c\u0645\u0648\u0639\u0629\u060c \u0623\u0648 \u062b\u0644\u0627\u062b\u064a\u0629 \u0627\u0644\u0623\u0637\u0631\u0627\u0641)"
    },
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u064a\u0646"
    },
    "participant_roles": {
      "type": "object",
      "properties": {
        "client": {
          "type": "string"
        },
        "engineer": {
          "type": "string"
        },
        "firm": {
          "type": "string"
        }
      },
      "description": "\u0623\u062f\u0648\u0627\u0631 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u064a\u0646 (\u0628\u0631\u064a\u062f \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0643\u0644 \u062f\u0648\u0631)"
    },
    "admin_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0645\u0633\u0624\u0648\u0644\u0648 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629"
    },
    "last_message": {
      "type": "string",
      "description": "\u0622\u062e\u0631 \u0631\u0633\u0627\u0644\u0629"
    },
    "last_message_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0622\u062e\u0631 \u0631\u0633\u0627\u0644\u0629"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u062a\u0645 \u0623\u0631\u0634\u0641\u0629 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 (\u063a\u064a\u0631 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062d\u0630\u0641)"
    },
    "muted_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u0623\u0633\u0643\u062a\u0648\u0627 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a"
    },
    "is_main_room": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0647\u064a \u063a\u0631\u0641\u0629 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629"
    }
  },
  "required": [
    "project_id",
    "participants"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.participants": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.admin_emails": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
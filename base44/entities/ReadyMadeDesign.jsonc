{
  "name": "ReadyMadeDesign",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0628\u0627\u0626\u0639 (\u0645\u0647\u0646\u062f\u0633 \u0623\u0648 \u0634\u0631\u0643\u0629)"
    },
    "seller_type": {
      "type": "string",
      "enum": [
        "engineer",
        "firm"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0628\u0627\u0626\u0639"
    },
    "seller_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0628\u0627\u0626\u0639"
    },
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062a\u0635\u0645\u064a\u0645"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u062a\u0635\u0645\u064a\u0645"
    },
    "category": {
      "type": "string",
      "enum": [
        "villa",
        "apartment",
        "facade",
        "interior",
        "landscape",
        "commercial"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062a\u0635\u0645\u064a\u0645"
    },
    "design_style": {
      "type": "string",
      "enum": [
        "modern",
        "classic",
        "islamic",
        "contemporary",
        "minimalist",
        "luxury"
      ],
      "description": "\u0627\u0644\u0646\u0645\u0637 \u0627\u0644\u0645\u0639\u0645\u0627\u0631\u064a"
    },
    "preview_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0635\u0648\u0631 \u0627\u0644\u0645\u0639\u0627\u064a\u0646\u0629"
    },
    "design_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0623\u0635\u0644\u064a\u0629 (\u0645\u062e\u0637\u0637\u0627\u062a\u060c DWG\u060c PDF)"
    },
    "price": {
      "type": "number",
      "description": "\u0627\u0644\u0633\u0639\u0631 \u0628\u0627\u0644\u0631\u064a\u0627\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a"
    },
    "area_sqm": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u0633\u0627\u062d\u0629 \u0628\u0627\u0644\u0645\u062a\u0631 \u0627\u0644\u0645\u0631\u0628\u0639"
    },
    "floors": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u0627\u0644\u0637\u0648\u0627\u0628\u0642"
    },
    "bedrooms": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u063a\u0631\u0641 \u0627\u0644\u0646\u0648\u0645"
    },
    "bathrooms": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u062f\u0648\u0631\u0627\u062a \u0627\u0644\u0645\u064a\u0627\u0647"
    },
    "specifications": {
      "type": "object",
      "properties": {
        "has_basement": {
          "type": "boolean",
          "default": false
        },
        "has_garage": {
          "type": "boolean",
          "default": false
        },
        "has_garden": {
          "type": "boolean",
          "default": false
        },
        "has_pool": {
          "type": "boolean",
          "default": false
        },
        "has_majlis": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "\u0627\u0644\u0645\u0648\u0627\u0635\u0641\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u064a\u0629"
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0645\u0627 \u064a\u062a\u0636\u0645\u0646\u0647 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 (\u0645\u062e\u0637\u0637\u0627\u062a \u0645\u0639\u0645\u0627\u0631\u064a\u0629\u060c \u0625\u0646\u0634\u0627\u0626\u064a\u0629\u060c \u0625\u0644\u062e)"
    },
    "modification_available": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u064a\u0645\u0643\u0646 \u0637\u0644\u0628 \u062a\u0639\u062f\u064a\u0644\u0627\u062a"
    },
    "modification_fee": {
      "type": "number",
      "description": "\u0631\u0633\u0648\u0645 \u0627\u0644\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0625\u0636\u0627\u0641\u064a\u0629"
    },
    "total_purchases": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a"
    },
    "rating": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u062a\u0642\u064a\u064a\u0645"
    },
    "total_reviews": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u062a\u0642\u064a\u064a\u0645\u0627\u062a"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "sold_out"
      ],
      "default": "active",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u0635\u0645\u064a\u0645"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u0645\u064a\u0632"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0648\u0633\u0648\u0645 \u0627\u0644\u0628\u062d\u062b"
    }
  },
  "required": [
    "seller_id",
    "title",
    "price",
    "category"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
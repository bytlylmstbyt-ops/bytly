{
  "name": "SurveyResponse",
  "type": "object",
  "properties": {
    "respondent_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0634\u0627\u0631\u0643 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "respondent_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0634\u0627\u0631\u0643 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "user_role": {
      "type": "string",
      "enum": [
        "homeowner",
        "investor",
        "engineer",
        "contractor",
        "other"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "primary_need": {
      "type": "string",
      "enum": [
        "interior_design",
        "architecture",
        "civil_engineering",
        "surveying",
        "building_permit",
        "construction_tracking",
        "other"
      ],
      "description": "\u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0623\u0643\u062b\u0631 \u0627\u062d\u062a\u064a\u0627\u062c\u0627\u064b"
    },
    "biggest_challenge": {
      "type": "string",
      "description": "\u0623\u0643\u0628\u0631 \u062a\u062d\u062f\u064d \u064a\u0648\u0627\u062c\u0647\u0647 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0647\u0646\u062f\u0633\u064a\u0629",
      "maxLength": 1000
    },
    "platform_interest": {
      "type": "string",
      "enum": [
        "very_interested",
        "interested",
        "maybe",
        "not_interested"
      ],
      "description": "\u0645\u062f\u0649 \u0627\u0647\u062a\u0645\u0627\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0646\u0635\u0629"
    },
    "concept_rating": {
      "type": "number",
      "description": "\u062a\u0642\u064a\u064a\u0645 \u0641\u0643\u0631\u0629 \u0627\u0644\u0645\u0646\u0635\u0629 \u0645\u0646 1 \u0625\u0644\u0649 5"
    },
    "willing_to_pay": {
      "type": "string",
      "enum": [
        "yes",
        "after_trial",
        "depends",
        "no"
      ],
      "description": "\u0647\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0633\u062a\u0639\u062f \u0644\u0644\u062f\u0641\u0639 \u0645\u0642\u0627\u0628\u0644 \u0627\u0644\u062e\u062f\u0645\u0627\u062a"
    },
    "additional_comments": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629",
      "maxLength": 1000
    },
    "source_page": {
      "type": "string",
      "description": "\u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062a\u064a \u0638\u0647\u0631 \u0645\u0646\u0647\u0627 \u0627\u0644\u0627\u0633\u062a\u0637\u0644\u0627\u0639"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0645\u0648\u062c\u0632 \u0644\u0631\u062f \u0627\u0644\u0627\u0633\u062a\u0637\u0644\u0627\u0639",
      "maxLength": 500
    }
  },
  "required": [
    "user_role",
    "platform_interest"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
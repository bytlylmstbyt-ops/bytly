{
  "name": "Client",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "city": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "country": {
      "type": "string",
      "description": "\u0627\u0644\u062f\u0648\u0644\u0629"
    },
    "profile_image": {
      "type": "string",
      "description": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a"
    },
    "client_type": {
      "type": "string",
      "enum": [
        "individual",
        "investor"
      ],
      "default": "individual",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0639\u0645\u064a\u0644: \u0641\u0631\u062f (\u0635\u0627\u062d\u0628 \u0645\u0646\u0632\u0644) \u0623\u0648 \u0645\u0633\u062a\u062b\u0645\u0631/\u0645\u0637\u0648\u0631"
    },
    "company_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 (\u0644\u0644\u0645\u0633\u062a\u062b\u0645\u0631\u064a\u0646/\u0627\u0644\u0645\u0637\u0648\u0631\u064a\u0646)"
    },
    "preferred_firms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0645\u0641\u0636\u0644\u0629 (\u0644\u0644\u0645\u0633\u062a\u062b\u0645\u0631\u064a\u0646)"
    },
    "real_estate_portfolio": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "property_name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "planning",
              "construction",
              "completed"
            ]
          },
          "investment_value": {
            "type": "number"
          }
        }
      },
      "description": "\u0645\u062d\u0641\u0638\u0629 \u0627\u0644\u0639\u0642\u0627\u0631\u0627\u062a \u0644\u0644\u0645\u0633\u062a\u062b\u0645\u0631\u064a\u0646"
    },
    "trust_score": {
      "type": "number",
      "default": 0,
      "description": "\u0646\u0642\u0627\u0637 \u0627\u0644\u062b\u0642\u0629 (0-100) \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0633\u062c\u0644 \u0627\u0644\u062f\u0641\u0639 \u0648\u0627\u0644\u062a\u0648\u0627\u0635\u0644"
    },
    "payment_history_score": {
      "type": "number",
      "default": 0,
      "description": "\u0646\u0642\u0627\u0637 \u0633\u062c\u0644 \u0627\u0644\u062f\u0641\u0639"
    },
    "communication_score": {
      "type": "number",
      "default": 0,
      "description": "\u0646\u0642\u0627\u0637 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0648\u0627\u0636\u062d"
    },
    "on_time_payments": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u062f\u0641\u0639\u0627\u062a \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u062d\u062f\u062f"
    },
    "total_payments": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u062f\u0641\u0639\u0627\u062a"
    },
    "wallet_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u062d\u0641\u0638\u0629"
    },
    "total_projects": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639"
    },
    "subscription_type": {
      "type": "string",
      "enum": [
        "free_trial",
        "basic",
        "premium"
      ],
      "default": "free_trial",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "subscription_end_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629"
    },
    "is_subscription_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0646\u0634\u0637"
    },
    "notification_sent_15_days": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u062a\u0646\u0628\u064a\u0647 15 \u064a\u0648\u0645 \u0642\u0628\u0644 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "StrategicDecision",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "decision_date": {
      "type": "string",
      "format": "date"
    },
    "owner": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "in_progress",
        "implemented",
        "cancelled"
      ]
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "follow_up": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
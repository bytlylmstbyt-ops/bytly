{
  "name": "ClientInteraction",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "interaction_type": {
      "type": "string",
      "enum": [
        "call",
        "email",
        "meeting",
        "message",
        "note"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062a\u0641\u0627\u0639\u0644"
    },
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062a\u0641\u0627\u0639\u0644"
    },
    "content": {
      "type": "string",
      "description": "\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u062a\u0641\u0627\u0639\u0644"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ],
      "description": "\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u0634\u0627\u0639\u0631"
    },
    "sentiment_score": {
      "type": "number",
      "description": "\u062f\u0631\u062c\u0629 \u0627\u0644\u0645\u0634\u0627\u0639\u0631 \u0645\u0646 -1 \u0625\u0644\u0649 1"
    },
    "duration_minutes": {
      "type": "number",
      "description": "\u0645\u062f\u0629 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0629 \u0628\u0627\u0644\u062f\u0642\u0627\u0626\u0642"
    },
    "recorded_by": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0634\u062e\u0635 \u0627\u0644\u0630\u064a \u0633\u062c\u0644 \u0627\u0644\u062a\u0641\u0627\u0639\u0644"
    },
    "call_recording_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0629"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0645\u0644\u0641\u0627\u062a \u0645\u0631\u0641\u0642\u0629"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0639\u0644\u0627\u0645\u0627\u062a \u0644\u0644\u0641\u0647\u0631\u0633\u0629 (\u0634\u0643\u0648\u0649\u060c \u0637\u0644\u0628 \u062a\u0639\u062f\u064a\u0644\u060c \u0625\u0644\u062e)"
    },
    "follow_up_required": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u062a\u062a\u0637\u0644\u0628 \u0645\u062a\u0627\u0628\u0639\u0629"
    },
    "follow_up_by": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0634\u062e\u0635 \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0639\u0646 \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0645\u0642\u062a\u0631\u062d"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "\u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u0641\u0627\u0639\u0644"
    },
    "interaction_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0641\u0627\u0639\u0644"
    }
  },
  "required": [
    "client_email",
    "interaction_type",
    "title",
    "content"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.recorded_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recorded_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
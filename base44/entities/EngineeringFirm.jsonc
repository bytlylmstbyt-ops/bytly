{
  "name": "EngineeringFirm",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u064a\u0629"
    },
    "email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0634\u0631\u0643\u0629"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "commercial_registration": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "municipality_license": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u062a\u0631\u062e\u064a\u0635 \u0627\u0644\u0628\u0644\u062f\u064a\u0629"
    },
    "company_logo": {
      "type": "string",
      "description": "\u0634\u0639\u0627\u0631 \u0627\u0644\u0634\u0631\u0643\u0629"
    },
    "cover_image": {
      "type": "string",
      "description": "\u0635\u0648\u0631\u0629 \u0627\u0644\u063a\u0644\u0627\u0641"
    },
    "official_stamp": {
      "type": "string",
      "description": "\u062e\u062a\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u0631\u0633\u0645\u064a (\u0644\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a)"
    },
    "authorized_signature": {
      "type": "string",
      "description": "\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0645\u0641\u0648\u0636 \u0627\u0644\u0631\u0633\u0645\u064a"
    },
    "description": {
      "type": "string",
      "description": "\u0646\u0628\u0630\u0629 \u0639\u0646 \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u064a\u0629"
    },
    "city": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "country": {
      "type": "string",
      "description": "\u0627\u0644\u062f\u0648\u0644\u0629"
    },
    "website": {
      "type": "string",
      "description": "\u0645\u0648\u0642\u0639 \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "established_year": {
      "type": "number",
      "description": "\u0633\u0646\u0629 \u0627\u0644\u062a\u0623\u0633\u064a\u0633"
    },
    "team_size": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0623\u0639\u0636\u0627\u0621 \u0627\u0644\u0641\u0631\u064a\u0642"
    },
    "specializations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "structural",
          "mep",
          "fire_safety",
          "architectural",
          "civil",
          "electrical",
          "plumbing",
          "hvac"
        ]
      },
      "description": "\u0627\u0644\u062a\u062e\u0635\u0635\u0627\u062a"
    },
    "subscription_type": {
      "type": "string",
      "enum": [
        "free_trial",
        "monthly",
        "yearly"
      ],
      "default": "free_trial",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "subscription_end_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629"
    },
    "is_subscription_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0646\u0634\u0637"
    },
    "notification_sent_15_days": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u062a\u0646\u0628\u064a\u0647 15 \u064a\u0648\u0645 \u0642\u0628\u0644 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u0648\u062b\u0642 \u0645\u0646 \u0628\u064a\u062a\u0644\u064a"
    },
    "verification_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0648\u062b\u064a\u0642"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062d\u0633\u0627\u0628"
    },
    "total_projects": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639"
    },
    "active_projects": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0646\u0634\u0637\u0629"
    },
    "total_audits": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0627\u062a \u0627\u0644\u0645\u0646\u062c\u0632\u0629"
    },
    "average_approval_time": {
      "type": "number",
      "default": 0,
      "description": "\u0645\u062a\u0648\u0633\u0637 \u0648\u0642\u062a \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0628\u0627\u0644\u0623\u064a\u0627\u0645"
    },
    "client_satisfaction_rating": {
      "type": "number",
      "default": 0,
      "description": "\u062a\u0642\u064a\u064a\u0645 \u0631\u0636\u0627 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 (0-5)"
    },
    "wallet_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u062d\u0641\u0638\u0629"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u0629"
    }
  },
  "required": [
    "company_name",
    "email",
    "commercial_registration"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
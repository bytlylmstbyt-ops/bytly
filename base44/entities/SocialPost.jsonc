{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "linkedin",
        "twitter",
        "facebook",
        "instagram",
        "tiktok",
        "other"
      ],
      "description": "\u0627\u0644\u0645\u0646\u0635\u0629 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u0629"
    },
    "content": {
      "type": "string",
      "description": "\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u0646\u0634\u0648\u0631"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u0631\u0648\u0627\u0628\u0637 \u0627\u0644\u0648\u0633\u0627\u0626\u0637 \u0627\u0644\u0645\u0631\u0641\u0642\u0629"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "link",
        "video"
      ],
      "default": "text",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0646\u0634\u0648\u0631"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "publishing",
        "published",
        "failed",
        "cancelled"
      ],
      "default": "draft",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0646\u0634\u0648\u0631"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0648\u0642\u062a \u0627\u0644\u062c\u062f\u0648\u0644\u0629"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0648\u0642\u062a \u0627\u0644\u0646\u0634\u0631 \u0627\u0644\u0641\u0639\u0644\u064a"
    },
    "post_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0645\u0646\u0634\u0648\u0631 \u0628\u0639\u062f \u0627\u0644\u0646\u0634\u0631"
    },
    "post_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0646\u0634\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u0635\u0629"
    },
    "error_message": {
      "type": "string",
      "description": "\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u062e\u0637\u0623 \u0641\u064a \u062d\u0627\u0644 \u0627\u0644\u0641\u0634\u0644"
    },
    "action_type": {
      "type": "string",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u062a\u0633\u0648\u064a\u0642\u064a"
    },
    "metadata": {
      "type": "object",
      "description": "\u0628\u064a\u0627\u0646\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629 \u0645\u0646 \u0627\u0633\u062a\u062c\u0627\u0628\u0629 API"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "likes": {
          "type": "number",
          "default": 0
        },
        "comments": {
          "type": "number",
          "default": 0
        },
        "shares": {
          "type": "number",
          "default": 0
        },
        "reach": {
          "type": "number",
          "default": 0
        },
        "impressions": {
          "type": "number",
          "default": 0
        },
        "clicks": {
          "type": "number",
          "default": 0
        },
        "engagement_rate": {
          "type": "number",
          "default": 0
        }
      },
      "description": "\u0645\u0642\u0627\u064a\u064a\u0633 \u0627\u0644\u0623\u062f\u0627\u0621"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u0648\u0633\u0648\u0645 \u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0645\u0646\u0634\u0648\u0631"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0645\u0646\u0634\u0648\u0631"
    }
  },
  "required": [
    "platform",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "ContractAmendment",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0642\u062f \u0627\u0644\u0623\u0635\u0644\u064a"
    },
    "amendment_number": {
      "type": "number",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "amendment_type": {
      "type": "string",
      "enum": [
        "clause_modification",
        "term_extension",
        "price_adjustment",
        "scope_change",
        "other"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "old_value": {
            "type": "string"
          },
          "new_value": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "description": "\u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a\u0629"
    },
    "requested_by": {
      "type": "string",
      "description": "\u0627\u0644\u0637\u0631\u0641 \u0627\u0644\u0630\u064a \u0637\u0644\u0628 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved_by_client",
        "approved_by_engineer",
        "active",
        "rejected"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "client_signature": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0639\u0645\u064a\u0644 \u0639\u0644\u0649 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "engineer_signature": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0639\u0644\u0649 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "client_signature_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "engineer_signature_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0645\u0647\u0646\u062f\u0633"
    },
    "effective_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0633\u0631\u064a\u0627\u0646 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "amendment_pdf_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0645\u0644\u0641 \u0627\u0644\u062a\u0639\u062f\u064a\u0644 PDF"
    }
  },
  "required": [
    "contract_id",
    "amendment_number",
    "amendment_type",
    "description"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.contract_id": {
            "_filter": "Contract",
            "read": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.contract_id": {
            "_filter": "Contract",
            "update": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.contract_id": {
            "_filter": "Contract",
            "delete": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
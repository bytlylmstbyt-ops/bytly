{
  "name": "AIAssistantQueryLog",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u0627\u0644\u0633\u0624\u0627\u0644 \u0643\u0645\u0627 \u0643\u062a\u0628\u0647 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "language": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ],
      "description": "\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0645\u0643\u062a\u0634\u0641\u0629 \u0644\u0644\u0633\u0624\u0627\u0644"
    },
    "asked_by_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0630\u064a \u0637\u0631\u062d \u0627\u0644\u0633\u0624\u0627\u0644"
    },
    "asked_by_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0630\u064a \u0637\u0631\u062d \u0627\u0644\u0633\u0624\u0627\u0644"
    },
    "capability_used": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0642\u062f\u0631\u0629 (Capability) \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u062e\u062f\u0645\u0647\u0627 \u0627\u0644\u0645\u0633\u0627\u0639\u062f \u0644\u0644\u0625\u062c\u0627\u0628\u0629"
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0643\u064a\u0627\u0646\u0627\u062a/\u0627\u0644\u062c\u062f\u0627\u0648\u0644 \u0627\u0644\u062a\u064a \u062a\u0645\u062a \u0642\u0631\u0627\u0621\u062a\u0647\u0627 (\u0642\u0631\u0627\u0621\u0629 \u0641\u0642\u0637) \u0644\u0644\u0625\u062c\u0627\u0628\u0629 \u0639\u0644\u0649 \u0627\u0644\u0633\u0624\u0627\u0644"
    },
    "row_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0633\u062c\u0644\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0645\u062a \u0642\u0631\u0627\u0621\u062a\u0647\u0627"
    },
    "answer_summary": {
      "type": "string",
      "maxLength": 2000,
      "description": "\u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629 \u0627\u0644\u062a\u064a \u0639\u064f\u0631\u0636\u062a \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "success": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u062a\u0645\u062a \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0628\u0646\u062c\u0627\u062d"
    },
    "error_message": {
      "type": "string",
      "description": "\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u062e\u0637\u0623 \u0641\u064a \u062d\u0627\u0644 \u0627\u0644\u0641\u0634\u0644"
    },
    "response_time_ms": {
      "type": "number",
      "description": "\u0632\u0645\u0646 \u0627\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0628\u0627\u0644\u0645\u064a\u0644\u064a \u062b\u0627\u0646\u064a\u0629"
    }
  },
  "required": [
    "question",
    "asked_by_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
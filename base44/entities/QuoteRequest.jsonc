{
  "name": "QuoteRequest",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_phone": {
      "type": "string",
      "description": "\u0647\u0627\u062a\u0641 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "project_title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "residential",
        "commercial",
        "industrial",
        "renovation",
        "interior",
        "landscape",
        "other"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "project_description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "location": {
      "type": "string",
      "description": "\u0645\u0648\u0642\u0639 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "land_area": {
      "type": "number",
      "description": "\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0623\u0631\u0636 \u0628\u0627\u0644\u0645\u062a\u0631 \u0627\u0644\u0645\u0631\u0628\u0639"
    },
    "floors_count": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u0627\u0644\u0637\u0648\u0627\u0628\u0642"
    },
    "budget_range": {
      "type": "string",
      "enum": [
        "under_100k",
        "100k_300k",
        "300k_500k",
        "500k_1m",
        "over_1m"
      ],
      "description": "\u0646\u0637\u0627\u0642 \u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0629"
    },
    "timeline": {
      "type": "string",
      "description": "\u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0632\u0645\u0646\u064a \u0627\u0644\u0645\u0637\u0644\u0648\u0628"
    },
    "engineering_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0647\u0646\u062f\u0633\u064a\u0629 \u0648\u0627\u0644\u0645\u062e\u0637\u0637\u0627\u062a"
    },
    "file_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u0644\u0641\u0627\u062a"
    },
    "special_requirements": {
      "type": "string",
      "description": "\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u062e\u0627\u0635\u0629"
    },
    "target_engineer_id": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "target_engineer_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "quoted",
        "accepted",
        "rejected"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628"
    },
    "engineer_estimate": {
      "type": "number",
      "description": "\u062a\u0642\u062f\u064a\u0631 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0628\u0627\u0644\u0631\u064a\u0627\u0644"
    },
    "engineer_notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0647\u0646\u062f\u0633"
    },
    "estimated_duration": {
      "type": "string",
      "description": "\u0645\u062f\u0629 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0645\u0642\u062f\u0631\u0629"
    }
  },
  "required": [
    "client_name",
    "client_email",
    "project_title",
    "project_type"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.target_engineer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.target_engineer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
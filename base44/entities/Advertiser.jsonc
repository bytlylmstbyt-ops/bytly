{
  "name": "Advertiser",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0634\u0631\u0643\u0629 \u0627\u0644\u0645\u0639\u0644\u0646"
    },
    "contact_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0634\u062e\u0635 \u0627\u0644\u0645\u0633\u0624\u0648\u0644 / \u0627\u0644\u0645\u0639\u0644\u0646"
    },
    "email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0645\u0639\u0644\u0646"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u062a\u0648\u0627\u0635\u0644"
    },
    "city": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "country": {
      "type": "string",
      "description": "\u0627\u0644\u062f\u0648\u0644\u0629"
    },
    "category": {
      "type": "string",
      "enum": [
        "engineering",
        "contracting",
        "decor",
        "building_materials",
        "furniture",
        "consulting_office",
        "concrete_supply",
        "electrical",
        "plumbing",
        "landscape"
      ],
      "description": "\u0642\u0637\u0627\u0639 \u0627\u0644\u0625\u0639\u0644\u0627\u0646"
    },
    "ad_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "gif"
      ],
      "default": "image",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0625\u0639\u0644\u0627\u0646 \u0627\u0644\u0623\u0633\u0627\u0633\u064a"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062d\u0633\u0627\u0628"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u0639\u0644\u0646 \u0645\u0648\u062b\u0651\u0642"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "\u0645\u062a\u0627\u062d (\u063a\u064a\u0631 \u0645\u0639\u0644\u0651\u0642)"
    },
    "subscription_type": {
      "type": "string",
      "enum": [
        "free_trial",
        "monthly",
        "yearly",
        "campaign"
      ],
      "default": "campaign",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "subscription_value": {
      "type": "number",
      "default": 0,
      "description": "\u0642\u064a\u0645\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "campaign_value": {
      "type": "number",
      "default": 0,
      "description": "\u0642\u064a\u0645\u0629 \u0627\u0644\u062d\u0645\u0644\u0629 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u064a\u0629"
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0625\u0646\u0641\u0627\u0642 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u064a (\u0644\u0644\u0625\u064a\u0631\u0627\u062f\u0627\u062a)"
    },
    "wallet_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u062d\u0641\u0638\u0629"
    },
    "available_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u062d"
    },
    "pending_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u0639\u0644\u0642"
    },
    "iban": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0622\u064a\u0628\u0627\u0646"
    },
    "bank_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0628\u0646\u0643"
    },
    "account_holder_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0635\u0627\u062d\u0628 \u0627\u0644\u062d\u0633\u0627\u0628"
    },
    "bio": {
      "type": "string",
      "description": "\u0646\u0628\u0630\u0629 \u0639\u0646 \u0627\u0644\u0645\u0639\u0644\u0646"
    },
    "website": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "logo_url": {
      "type": "string",
      "description": "\u0634\u0639\u0627\u0631 \u0627\u0644\u0645\u0639\u0644\u0646"
    }
  },
  "required": [
    "company_name",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
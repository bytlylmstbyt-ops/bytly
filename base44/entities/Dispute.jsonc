{
  "name": "Dispute",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "contract_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0642\u062f \u0627\u0644\u0645\u0631\u062a\u0628\u0637 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "raised_by": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0645\u0646 \u0631\u0641\u0639 \u0627\u0644\u0646\u0632\u0627\u0639"
    },
    "raised_against": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0637\u0631\u0641 \u0627\u0644\u0622\u062e\u0631"
    },
    "dispute_type": {
      "type": "string",
      "enum": [
        "payment_issue",
        "quality_issue",
        "deadline_issue",
        "contract_breach",
        "communication_issue",
        "scope_change",
        "other"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0646\u0632\u0627\u0639"
    },
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0646\u0632\u0627\u0639"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u062a\u0641\u0635\u064a\u0644\u064a \u0644\u0644\u0646\u0632\u0627\u0639"
    },
    "evidence_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0631\u0648\u0627\u0628\u0637 \u0627\u0644\u0623\u062f\u0644\u0629 \u0648\u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "\u0623\u0648\u0644\u0648\u064a\u0629 \u0627\u0644\u0646\u0632\u0627\u0639"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "investigation",
        "mediation",
        "resolved",
        "closed",
        "escalated"
      ],
      "default": "submitted",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0646\u0632\u0627\u0639"
    },
    "resolution_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_number": {
            "type": "number"
          },
          "step_title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "responsible_party": {
            "type": "string"
          },
          "deadline": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "failed"
            ]
          },
          "completion_date": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "\u062e\u0637\u0648\u0627\u062a \u0627\u0644\u062d\u0644 \u0627\u0644\u0645\u062d\u062f\u062f\u0629"
    },
    "admin_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "admin_email": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "action_taken": {
            "type": "string"
          }
        }
      },
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0648\u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0645\u062a\u062e\u0630\u0629"
    },
    "assigned_admin": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0645\u0643\u0644\u0641 \u0628\u0627\u0644\u0646\u0632\u0627\u0639"
    },
    "resolution_summary": {
      "type": "string",
      "description": "\u0645\u0644\u062e\u0635 \u0627\u0644\u062d\u0644 \u0627\u0644\u0646\u0647\u0627\u0626\u064a"
    },
    "resolution_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u062d\u0644 \u0627\u0644\u0646\u0632\u0627\u0639"
    },
    "compensation_amount": {
      "type": "number",
      "description": "\u0645\u0628\u0644\u063a \u0627\u0644\u062a\u0639\u0648\u064a\u0636 (\u0625\u0646 \u0648\u062c\u062f)"
    },
    "client_satisfaction": {
      "type": "number",
      "description": "\u062a\u0642\u064a\u064a\u0645 \u0631\u0636\u0627 \u0627\u0644\u0639\u0645\u064a\u0644 \u0639\u0646 \u0627\u0644\u062d\u0644 (1-5)"
    },
    "engineer_satisfaction": {
      "type": "number",
      "description": "\u062a\u0642\u064a\u064a\u0645 \u0631\u0636\u0627 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0639\u0646 \u0627\u0644\u062d\u0644 (1-5)"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sender_email": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "is_internal": {
            "type": "boolean",
            "description": "\u0647\u0644 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u062f\u0627\u062e\u0644\u064a\u0629 \u0644\u0644\u0625\u062f\u0627\u0631\u0629 \u0641\u0642\u0637"
          }
        }
      },
      "description": "\u0633\u062c\u0644 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0648\u0627\u0644\u0631\u0633\u0627\u0626\u0644"
    },
    "escalation_reason": {
      "type": "string",
      "description": "\u0633\u0628\u0628 \u0627\u0644\u062a\u0635\u0639\u064a\u062f (\u0625\u0646 \u0648\u062c\u062f)"
    },
    "escalated_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0635\u0639\u064a\u062f"
    }
  },
  "required": [
    "project_id",
    "raised_by",
    "dispute_type",
    "title",
    "description"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "\u0420\u0455r": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.raised_by": "{{user.email}}"
        },
        {
          "data.raised_against": "{{user.email}}"
        },
        {
          "data.assigned_admin": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "\u0420\u0455r": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.raised_by": "{{user.email}}"
        },
        {
          "data.raised_against": "{{user.email}}"
        },
        {
          "data.assigned_admin": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
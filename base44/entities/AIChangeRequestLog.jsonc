    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u0648\u0635\u0641 \u0645\u0648\u062c\u0632 \u0644\u0637\u0644\u0628 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"

    "block_reason": {
      "type": "string",
      "maxLength": 500,
      "description": "\u0633\u0628\u0628 \u062d\u0638\u0631 \u0627\u0644\u0637\u0644\u0628 \u0645\u0646 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0622\u0644\u064a (\u0625\u0646 \u0648\u064f\u062c\u062f)"

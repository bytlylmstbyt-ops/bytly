      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u064a\u062d\u062a\u0627\u062c \u062a\u0639\u062f\u064a\u0644 \u0635\u0644\u0627\u062d\u064a\u0627\u062a"
    },
    "tests_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0642\u062a\u0631\u062d\u0629 \u0642\u0628\u0644 \u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u062a\u063a\u064a\u064a\u0631 \u0641\u0639\u0644\u064a\u064b\u0627"
    },
    "plain_explanation_ar": {
      "type": "string",
      "maxLength": 2000,
      "description": "\u0634\u0631\u062d \u0645\u0628\u0633\u0651\u0637 \u0628\u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0644\u0645\u0627 \u0633\u064a\u062a\u063a\u064a\u0651\u0631\u060c \u0644\u063a\u064a\u0631 \u0627\u0644\u0645\u0628\u0631\u0645\u062c"

    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "rejected"
      ],
      "default": "proposed",
      "description": "\u062d\u0627\u0644\u0629 \u062e\u0637\u0629 \u0627\u0644\u062a\u063a\u064a\u064a\u0631: \u0645\u0642\u062a\u0631\u062d\u0629\u060c \u062a\u0645\u062a \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u064a\u0647\u0627\u060c \u0623\u0648 \u0645\u0631\u0641\u0648\u0636\u0629. \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0647\u0646\u0627 \u0644\u0627 \u062a\u064f\u0646\u0641\u0651\u0630 \u0627\u0644\u0643\u0648\u062f \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u2014 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0641\u0639\u0644\u064a \u064a\u062f\u0648\u064a \u062f\u0627\u0626\u0645\u064b\u0627 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0645\u0631\u062d\u0644\u0629."
    },
    "execution_note": {
      "type": "string",
      "maxLength": 500,
      "description": "\u0645\u0644\u0627\u062d\u0638\u0629 \u062d\u0648\u0644 \u0643\u064a\u0641\u064a\u0629/\u0645\u0648\u0639\u062f \u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0641\u0639\u0644\u064a (\u064a\u062f\u0648\u064a\u064b\u0627 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0645\u0637\u0648\u0651\u0631/\u0627\u0644\u062c\u0644\u0633\u0629 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629)"

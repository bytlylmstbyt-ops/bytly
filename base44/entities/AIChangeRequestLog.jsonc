    "diff_preview": {
      "type": "string",
      "maxLength": 3000,
      "description": "\u0645\u0639\u0627\u064a\u0646\u0629 \u0646\u0635\u064a\u0629 \u0634\u0628\u064a\u0647\u0629 \u0628\u0627\u0644\u0640 diff \u0644\u0644\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0645\u0642\u062a\u0631\u062d (\u0644\u0644\u0627\u0637\u0644\u0627\u0639 \u0627\u0644\u062a\u0642\u0646\u064a \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u062a\u0645 \u062d\u0638\u0631 \u0647\u0630\u0627 \u0627\u0644\u0637\u0644\u0628 \u0645\u0646 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0644\u0623\u0646\u0647 \u064a\u0645\u0633 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a/\u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0627\u062a/\u0627\u0644\u0623\u0645\u0648\u0631 \u0627\u0644\u0645\u0627\u0644\u064a\u0629/\u0627\u0644\u0625\u0646\u062a\u0627\u062c"

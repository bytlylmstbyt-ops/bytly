    "problem_description": {
      "type": "string",
      "maxLength": 800,
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0627\u0644\u0645\u0643\u062a\u0634\u0641\u0629 (\u064a\u064f\u0645\u0644\u0623 \u0641\u0642\u0637 \u0644\u0637\u0644\u0628\u0627\u062a \u062a\u0634\u062e\u064a\u0635/\u0625\u0635\u0644\u0627\u062d\u060c \u0648\u0644\u064a\u0633 \u0644\u0637\u0644\u0628\u0627\u062a \u0645\u064a\u0632\u0629 \u062c\u062f\u064a\u062f\u0629)"

{
  "name": "GitHubIssue",
  "type": "object",
  "properties": {
    "repo_full_name": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639 \u0628\u0635\u064a\u063a\u0629 owner/repo"
    },
    "issue_number": {
      "type": "number",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639"
    },
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0634\u0643\u0644\u0629"
    },
    "body": {
      "type": "string",
      "description": "\u0646\u0635 \u0627\u0644\u0645\u0634\u0643\u0644\u0629"
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0634\u0643\u0644\u0629"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u0648\u0633\u0648\u0645 \u0627\u0644\u0645\u0634\u0643\u0644\u0629"
    },
    "assignees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u0627\u0644\u0645\u0633\u0624\u0648\u0644\u0648\u0646 \u0639\u0646 \u0627\u0644\u0645\u0634\u0643\u0644\u0629"
    },
    "author": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0645\u0646\u0634\u0626 \u0627\u0644\u0645\u0634\u0643\u0644\u0629"
    },
    "html_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0639\u0644\u0649 GitHub"
    },
    "github_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0639\u0644\u0649 GitHub"
    },
    "github_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0622\u062e\u0631 \u062a\u062d\u062f\u064a\u062b \u0644\u0644\u0645\u0634\u0643\u0644\u0629 \u0639\u0644\u0649 GitHub"
    },
    "synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0622\u062e\u0631 \u0645\u0632\u0627\u0645\u0646\u0629 \u0644\u0644\u0633\u062c\u0644"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u0648\u0635\u0641 \u0645\u0648\u062c\u0632 \u0644\u0644\u0645\u0634\u0643\u0644\u0629 \u0644\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0641\u0647\u0631\u0633\u0629"
    }
  },
  "required": [
    "repo_full_name",
    "issue_number",
    "title",
    "state"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
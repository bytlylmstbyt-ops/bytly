{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 \u0623\u0648 \u0627\u0644\u0645\u0648\u0631\u062f"
    },
    "email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u062a\u0648\u0627\u0635\u0644"
    },
    "supplier_type": {
      "type": "string",
      "enum": [
        "individual",
        "company"
      ],
      "default": "company",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0648\u0631\u062f: \u0641\u0631\u062f \u0623\u0648 \u0634\u0631\u0643\u0629"
    },
    "specialization": {
      "type": "string",
      "description": "\u0627\u0644\u062a\u062e\u0635\u0635 \u0627\u0644\u062f\u0642\u064a\u0642"
    },
    "product_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0641\u0626\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0623\u0648 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0642\u062f\u0645\u0629"
    },
    "commercial_registration": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "license_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0631\u062e\u0635\u0629 \u0627\u0644\u0639\u0645\u0644"
    },
    "license_file": {
      "type": "string",
      "description": "\u0645\u0631\u0641\u0642 \u0631\u062e\u0635\u0629 \u0627\u0644\u0639\u0645\u0644"
    },
    "registration_file": {
      "type": "string",
      "description": "\u0645\u0631\u0641\u0642 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "bio": {
      "type": "string",
      "description": "\u0646\u0628\u0630\u0629 \u062a\u0639\u0631\u064a\u0641\u064a\u0629"
    },
    "city": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "country": {
      "type": "string",
      "description": "\u0627\u0644\u062f\u0648\u0644\u0629"
    },
    "profile_image": {
      "type": "string",
      "description": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a / \u0627\u0644\u0634\u0639\u0627\u0631"
    },
    "cover_image": {
      "type": "string",
      "description": "\u0635\u0648\u0631\u0629 \u0627\u0644\u063a\u0644\u0627\u0641"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u0629"
    },
    "years_experience": {
      "type": "number",
      "description": "\u0633\u0646\u0648\u0627\u062a \u0627\u0644\u062e\u0628\u0631\u0629"
    },
    "established_year": {
      "type": "number",
      "description": "\u0633\u0646\u0629 \u0627\u0644\u062a\u0623\u0633\u064a\u0633"
    },
    "website": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u0648\u0631\u062f \u0645\u0648\u062b\u0642 \u0645\u0646 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0646\u0635\u0629"
    },
    "verification_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0648\u062b\u064a\u0642"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062d\u0633\u0627\u0628"
    },
    "rating": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0639\u0627\u0645 \u0645\u0646 5"
    },
    "total_reviews": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u062a\u0642\u064a\u064a\u0645\u0627\u062a"
    },
    "total_orders": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0646\u062c\u0632\u0629"
    },
    "active_orders": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0646\u0634\u0637\u0629 \u062d\u0627\u0644\u064a\u0627\u064b"
    },
    "wallet_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u062d\u0641\u0638\u0629"
    },
    "available_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u062d \u0644\u0644\u0633\u062d\u0628"
    },
    "pending_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u0639\u0644\u0642 \u0642\u064a\u062f \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f"
    },
    "iban": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0622\u064a\u0628\u0627\u0646 \u0644\u0644\u062a\u062d\u0648\u064a\u0644\u0627\u062a \u0627\u0644\u0628\u0646\u0643\u064a\u0629"
    },
    "bank_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0628\u0646\u0643"
    },
    "account_holder_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0635\u0627\u062d\u0628 \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0628\u0646\u0643\u064a"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "\u0645\u062a\u0627\u062d \u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0637\u0644\u0628\u0627\u062a \u062c\u062f\u064a\u062f\u0629"
    }
  },
  "required": [
    "company_name",
    "email",
    "specialization"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
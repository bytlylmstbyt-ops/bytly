{
  "name": "ConsultationAppointment",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_phone": {
      "type": "string",
      "description": "\u0647\u0627\u062a\u0641 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "engineer",
        "firm"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0647\u062f\u0641: \u0645\u0647\u0646\u062f\u0633 \u0623\u0648 \u0634\u0631\u0643\u0629"
    },
    "target_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0623\u0648 \u0627\u0644\u0634\u0631\u0643\u0629"
    },
    "target_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0623\u0648 \u0627\u0644\u0634\u0631\u0643\u0629"
    },
    "target_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0623\u0648 \u0627\u0644\u0634\u0631\u0643\u0629"
    },
    "appointment_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0648\u0639\u062f"
    },
    "appointment_time": {
      "type": "string",
      "description": "\u0648\u0642\u062a \u0627\u0644\u0645\u0648\u0639\u062f"
    },
    "consultation_type": {
      "type": "string",
      "enum": [
        "video_call",
        "phone_call",
        "in_person"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u0629"
    },
    "topic": {
      "type": "string",
      "description": "\u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u0629"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0648\u0639\u062f"
    }
  },
  "required": [
    "client_id",
    "target_id",
    "target_type",
    "appointment_date",
    "appointment_time"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.target_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.target_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "TechnicalReview",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "consultant_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0641\u0646\u064a"
    },
    "compliance_status": {
      "type": "string",
      "enum": [
        "compliant",
        "compliant_with_notes",
        "non_compliant"
      ],
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629"
    },
    "saudi_code_compliance": {
      "type": "string",
      "description": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629 \u0644\u0644\u0643\u0648\u062f \u0627\u0644\u0633\u0639\u0648\u062f\u064a"
    },
    "implementation_recommendations": {
      "type": "string",
      "description": "\u062a\u0648\u0635\u064a\u0627\u062a \u0627\u0644\u062a\u0646\u0641\u064a\u0630"
    },
    "quality_assessment": {
      "type": "string",
      "description": "\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u062c\u0648\u062f\u0629"
    },
    "technical_notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0641\u0646\u064a\u0629 \u0625\u0636\u0627\u0641\u064a\u0629"
    },
    "report_file": {
      "type": "string",
      "description": "\u0645\u0644\u0641 \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0645\u062e\u062a\u0648\u0645 PDF"
    },
    "corrected_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0635\u062d\u062d\u0629 \u0627\u0644\u0645\u0631\u0641\u0642\u0629 (\u0645\u062e\u0637\u0637\u0627\u062a \u0645\u0639\u062f\u0644\u0629\u060c \u0648\u062b\u0627\u0626\u0642 \u0645\u0631\u0627\u062c\u0639\u0629)"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f"
    },
    "review_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "consultant_fee": {
      "type": "number",
      "default": 0,
      "description": "\u0623\u062a\u0639\u0627\u0628 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0634\u0627\u0645\u0644 \u0644\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0641\u0646\u064a\u0629 \u0648\u0646\u062a\u0627\u0626\u062c\u0647\u0627",
      "maxLength": 1000
    }
  },
  "required": [
    "project_id",
    "consultant_id",
    "compliance_status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.consultant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.consultant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
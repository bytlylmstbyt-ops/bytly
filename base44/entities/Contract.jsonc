{
  "name": "Contract",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "client_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "engineer_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0647\u0646\u062f\u0633"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "project_start",
        "service_agreement"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0639\u0642\u062f: \u0639\u0642\u062f \u0628\u062f\u0621 \u0645\u0634\u0631\u0648\u0639 \u0623\u0648 \u0639\u0642\u062f \u062a\u0642\u062f\u064a\u0645 \u062e\u062f\u0645\u0627\u062a"
    },
    "contract_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0639\u0642\u062f"
    },
    "service_description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u062e\u062f\u0645\u0629"
    },
    "total_amount": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a"
    },
    "payment_terms": {
      "type": "string",
      "description": "\u0634\u0631\u0648\u0637 \u0627\u0644\u062f\u0641\u0639"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0633\u0644\u064a\u0645"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u062f\u0621"
    },
    "additional_terms": {
      "type": "string",
      "description": "\u0628\u0646\u0648\u062f \u0625\u0636\u0627\u0641\u064a\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_signature",
        "signed",
        "active",
        "completed",
        "terminated",
        "archived"
      ],
      "default": "draft",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0639\u0642\u062f"
    },
    "client_signature": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "engineer_signature": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0645\u0647\u0646\u062f\u0633"
    },
    "client_signature_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "engineer_signature_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0645\u0647\u0646\u062f\u0633"
    },
    "client_signature_ip": {
      "type": "string",
      "description": "IP \u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0639\u0645\u064a\u0644 \u0644\u0644\u062a\u0648\u062b\u064a\u0642"
    },
    "engineer_signature_ip": {
      "type": "string",
      "description": "IP \u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0644\u0644\u062a\u0648\u062b\u064a\u0642"
    },
    "contract_pdf_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0645\u0644\u0641 \u0627\u0644\u0639\u0642\u062f PDF"
    },
    "contract_version": {
      "type": "number",
      "default": 1,
      "description": "\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0639\u0642\u062f"
    },
    "previous_version_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0633\u0627\u0628\u0642 \u0625\u0646 \u0648\u062c\u062f"
    },
    "archive_reason": {
      "type": "string",
      "description": "\u0633\u0628\u0628 \u0627\u0644\u0623\u0631\u0634\u0641\u0629"
    },
    "archived_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0623\u0631\u0634\u0641\u0629"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u0627\u0644\u0645\u0639\u0627\u0644\u0645 \u0648\u0627\u0644\u062f\u0641\u0639\u0627\u062a"
    },
    "custom_clauses": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u0628\u0646\u0648\u062f \u0645\u062e\u0635\u0635\u0629 \u0625\u0636\u0627\u0641\u064a\u0629"
    }
  },
  "required": [
    "project_id",
    "client_id",
    "engineer_id",
    "contract_type",
    "total_amount"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.engineer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.engineer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
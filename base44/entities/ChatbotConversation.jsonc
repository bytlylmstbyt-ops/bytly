{
  "name": "ChatbotConversation",
  "type": "object",
  "properties": {
    "visitor_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0632\u0627\u0626\u0631 \u0627\u0644\u0641\u0631\u064a\u062f"
    },
    "user_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "\u0633\u062c\u0644 \u0627\u0644\u0631\u0633\u0627\u0626\u0644"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "visitor",
        "engineer",
        "client",
        "consultant"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed",
        "escalated"
      ],
      "default": "active",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629"
    },
    "assigned_support_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u062f\u0639\u0645 \u0627\u0644\u0645\u064f\u0633\u0646\u062f"
    },
    "suggested_engineers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0645\u0647\u0646\u062f\u0633\u064a\u0646 \u0645\u0642\u062a\u0631\u062d\u064a\u0646"
    },
    "description": {
      "type": "string",
      "description": "\u0645\u0644\u062e\u0635 \u0645\u0648\u062c\u0632 \u0644\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0648\u0627\u0644\u063a\u0631\u0636 \u0645\u0646\u0647\u0627",
      "maxLength": 1000
    }
  },
  "required": [
    "visitor_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.assigned_support_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.assigned_support_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Project",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0635\u0627\u062d\u0628 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "category": {
      "type": "string",
      "enum": [
        "interior",
        "architecture",
        "painting",
        "landscape",
        "furniture",
        "lighting"
      ],
      "description": "\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "full_construction",
        "express_service"
      ],
      "default": "express_service",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0634\u0631\u0648\u0639: \u0645\u0634\u0631\u0648\u0639 \u0628\u0646\u0627\u0621 \u0643\u0627\u0645\u0644 \u0623\u0648 \u062e\u062f\u0645\u0629 \u0633\u0631\u064a\u0639\u0629"
    },
    "is_direct_hire": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0647\u0630\u0627 \u0637\u0644\u0628 \u062e\u062f\u0645\u0629 \u0645\u0628\u0627\u0634\u0631\u0629 (\u0644\u0627 \u064a\u0638\u0647\u0631 \u0641\u064a \u0627\u0644\u0633\u0648\u0642 \u0627\u0644\u0639\u0627\u0645\u0629)"
    },
    "budget_min": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0627\u0644\u0623\u062f\u0646\u0649"
    },
    "budget_max": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0627\u0644\u0623\u0642\u0635\u0649"
    },
    "location": {
      "type": "string",
      "description": "\u0645\u0648\u0642\u0639 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "\u0627\u0644\u0645\u0648\u0639\u062f \u0627\u0644\u0646\u0647\u0627\u0626\u064a"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u0631\u0641\u0642\u0627\u062a"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "awaiting_technical_review",
        "technical_approved",
        "pending_client_approval",
        "completed",
        "cancelled",
        "disputed"
      ],
      "default": "open",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "assigned_engineer_id": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0627\u0644\u0645\u0639\u064a\u0646"
    },
    "revisions_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629"
    },
    "max_revisions": {
      "type": "number",
      "default": 3,
      "description": "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0627\u0644\u0645\u0633\u0645\u0648\u062d\u0629"
    },
    "technical_consultant_id": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0641\u0646\u064a \u0627\u0644\u0645\u0639\u064a\u0646"
    },
    "technical_review_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0641\u0646\u064a\u0629"
    },
    "technical_review_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0641\u0646\u064a\u0629"
    },
    "technical_report_file": {
      "type": "string",
      "description": "\u0645\u0644\u0641 \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0641\u0646\u064a PDF"
    },
    "legal_consultant_id": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a \u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u0646\u0632\u0627\u0639"
    },
    "legal_review_notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629"
    },
    "final_deliverable_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0645\u062e\u0631\u062c \u0627\u0644\u0646\u0647\u0627\u0626\u064a"
    },
    "client_final_approval": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629"
    },
    "client_approval_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "escrow_amount": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062d\u062c\u0648\u0632 \u0641\u064a \u0627\u0644\u0636\u0645\u0627\u0646"
    },
    "escrow_status": {
      "type": "string",
      "enum": [
        "none",
        "held",
        "released",
        "refunded"
      ],
      "default": "none",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0636\u0645\u0627\u0646"
    },
    "platform_commission": {
      "type": "number",
      "default": 15,
      "description": "\u0646\u0633\u0628\u0629 \u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u0645\u0646\u0635\u0629 \u0628\u0627\u0644\u0645\u0626\u0629"
    },
    "technical_consultant_fee": {
      "type": "number",
      "default": 0,
      "description": "\u0623\u062a\u0639\u0627\u0628 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0641\u0646\u064a"
    },
    "legal_consultant_fee": {
      "type": "number",
      "default": 0,
      "description": "\u0623\u062a\u0639\u0627\u0628 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a"
    },
    "engineer_payment": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0635\u0627\u0641\u064a \u0644\u0644\u0645\u0647\u0646\u062f\u0633"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "escrowed",
        "released",
        "completed"
      ],
      "default": "unpaid",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "total_proposals": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0639\u0631\u0648\u0636"
    }
  },
  "required": [
    "client_id",
    "title",
    "description"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.assigned_engineer_id": "{{user.id}}"
        },
        {
          "data.technical_consultant_id": "{{user.id}}"
        },
        {
          "data.legal_consultant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_engineer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "SurveyDeliverable",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0637\u0644\u0628 \u0627\u0644\u0645\u0633\u062d"
    },
    "surveyor_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u0627\u062d"
    },
    "cad_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0645\u0644\u0641\u0627\u062a CAD (dwg, dxf)"
    },
    "visual_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0631\u0626\u064a\u0629 (pdf, png, jpg - \u0643\u0631\u0648\u0643\u064a\u060c \u062a\u0642\u0627\u0631\u064a\u0631)"
    },
    "survey_metadata": {
      "type": "object",
      "properties": {
        "street_widths": {
          "type": "string",
          "description": "\u0639\u0631\u0636 \u0627\u0644\u0634\u0648\u0627\u0631\u0639 \u0627\u0644\u0645\u062d\u064a\u0637\u0629"
        },
        "setbacks": {
          "type": "string",
          "description": "\u0627\u0644\u0627\u0631\u062a\u062f\u0627\u062f\u0627\u062a"
        },
        "parcel_angles": {
          "type": "string",
          "description": "\u0632\u0648\u0627\u064a\u0627 \u0627\u0644\u0642\u0637\u0639\u0629"
        },
        "coordinates_system": {
          "type": "string",
          "description": "\u0646\u0638\u0627\u0645 \u0627\u0644\u0625\u062d\u062f\u0627\u062b\u064a\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
        },
        "additional_notes": {
          "type": "string",
          "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0641\u0646\u064a\u0629 \u0625\u0636\u0627\u0641\u064a\u0629"
        }
      },
      "description": "\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0648\u0635\u0641\u064a\u0629 \u0644\u0644\u0645\u0633\u062d"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0633\u0644\u064a\u0645"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0645\u062e\u0631\u062c\u0627\u062a",
      "maxLength": 1000
    }
  },
  "required": [
    "request_id",
    "surveyor_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.request_id": {
            "_filter": "SurveyRequest",
            "read": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
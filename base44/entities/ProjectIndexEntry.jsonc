{
  "name": "ProjectIndexEntry",
  "type": "object",
  "properties": {
    "file_path": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0633\u0627\u0631 \u0627\u0644\u0641\u0639\u0644\u064a \u0644\u0644\u0645\u0644\u0641 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "page",
        "entity",
        "function"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0644\u0641: \u0635\u0641\u062d\u0629 \u0648\u0627\u062c\u0647\u0629\u060c \u0643\u064a\u0627\u0646 \u0628\u064a\u0627\u0646\u0627\u062a\u060c \u0623\u0648 \u062f\u0627\u0644\u0629 \u062e\u0644\u0641\u064a\u0629"
    },
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0635\u0641\u062d\u0629/\u0627\u0644\u0643\u064a\u0627\u0646/\u0627\u0644\u062f\u0627\u0644\u0629"
    },
    "route": {
      "type": "string",
      "description": "\u0645\u0633\u0627\u0631 \u0627\u0644\u0640 route \u0625\u0646 \u0648\u064f\u062c\u062f (\u0644\u0644\u0635\u0641\u062d\u0627\u062a \u0641\u0642\u0637)"
    },
    "related_entities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0643\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629 \u0641\u0639\u0644\u064a\u064b\u0627 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0645\u0644\u0641 (\u0645\u0633\u062a\u062e\u0631\u062c\u0629 \u0645\u0646 \u0627\u0644\u0643\u0648\u062f)"
    },
    "related_functions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u062f\u0648\u0627\u0644 Backend \u0627\u0644\u062a\u064a \u064a\u0633\u062a\u062f\u0639\u064a\u0647\u0627 \u0647\u0630\u0627 \u0627\u0644\u0645\u0644\u0641 \u0641\u0639\u0644\u064a\u064b\u0627"
    },
    "related_integrations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u062a\u0643\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u0643\u062a\u0634\u0641\u0629 (\u0628\u062f\u0648\u0646 \u0623\u064a \u0645\u0641\u0627\u062a\u064a\u062d \u0623\u0648 \u0623\u0633\u0631\u0627\u0631)"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0642\u0635\u064a\u0631 \u0645\u0633\u062a\u062e\u0631\u062c \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627"
    }
  },
  "required": [
    "file_path",
    "file_type",
    "name"
  ],
  "rls": {

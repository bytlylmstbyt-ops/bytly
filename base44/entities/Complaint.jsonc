{
  "name": "Complaint",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "type": {
      "type": "string",
      "enum": [
        "complaint",
        "suggestion",
        "feedback"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0625\u062f\u062e\u0627\u0644: \u0634\u0643\u0648\u0649\u060c \u0627\u0642\u062a\u0631\u0627\u062d\u060c \u0645\u0644\u0627\u062d\u0638\u0629"
    },
    "subject": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0648\u0636\u0648\u0639"
    },
    "description": {
      "type": "string",
      "description": "\u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0645\u0631\u0641\u0642\u0627\u062a"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_review",
        "resolved",
        "closed"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0634\u0643\u0648\u0649"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "\u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629"
    },
    "admin_response": {
      "type": "string",
      "description": "\u0631\u062f \u0627\u0644\u0625\u062f\u0627\u0631\u0629"
    },
    "resolution_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062d\u0644"
    }
  },
  "required": [
    "user_id",
    "type",
    "subject",
    "description"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
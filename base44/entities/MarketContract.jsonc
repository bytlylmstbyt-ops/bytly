{
  "name": "MarketContract",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0639\u0642\u062f"
    },
    "developer_entity_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0637\u0648\u0631 \u0627\u0644\u0639\u0642\u0627\u0631\u064a"
    },
    "developer_entity_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0637\u0648\u0631 \u0627\u0644\u0639\u0642\u0627\u0631\u064a"
    },
    "investor_entity_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631"
    },
    "investor_entity_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631"
    },
    "project_description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "total_amount": {
      "type": "number",
      "description": "\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0629 \u0644\u0644\u0639\u0642\u062f"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u062f\u0621"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621"
    },
    "contract_file_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0645\u0644\u0641 \u0627\u0644\u0639\u0642\u062f \u0627\u0644\u0645\u0631\u0641\u0648\u0639"
    },
    "contract_file_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0645\u0644\u0641 \u0627\u0644\u0639\u0642\u062f"
    },
    "developer_signed": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u0637\u0648\u0631 \u0627\u0644\u0631\u0642\u0645\u064a\u0629"
    },
    "developer_signed_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u0637\u0648\u0631"
    },
    "developer_signed_by": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0645\u0646 \u0648\u0642\u0651\u0639 \u0645\u0646 \u062c\u0647\u0629 \u0627\u0644\u0645\u0637\u0648\u0631"
    },
    "investor_signed": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631 \u0627\u0644\u0631\u0642\u0645\u064a\u0629"
    },
    "investor_signed_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631"
    },
    "investor_signed_by": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0645\u0646 \u0648\u0642\u0651\u0639 \u0645\u0646 \u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_signatures",
        "active",
        "completed",
        "terminated"
      ],
      "default": "draft",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0639\u0642\u062f: \u0645\u0633\u0648\u062f\u0629 / \u0642\u064a\u062f \u0627\u0644\u062a\u0648\u0642\u064a\u0639 / \u0642\u064a\u062f \u0627\u0644\u062a\u0646\u0641\u064a\u0630 / \u0645\u0643\u062a\u0645\u0644 / \u0645\u0644\u063a\u064a"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629"
    }
  },
  "required": [
    "title",
    "developer_entity_name",
    "investor_entity_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "ProjectWorkflow",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0633\u064a\u0631 \u0627\u0644\u0639\u0645\u0644"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0633\u064a\u0631 \u0627\u0644\u0639\u0645\u0644"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage_id": {
            "type": "string",
            "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u0641\u0631\u064a\u062f"
          },
          "name": {
            "type": "string",
            "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0631\u062d\u0644\u0629"
          },
          "description": {
            "type": "string",
            "description": "\u0648\u0635\u0641 \u0627\u0644\u0645\u0631\u062d\u0644\u0629"
          },
          "order": {
            "type": "number",
            "description": "\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0645\u0631\u062d\u0644\u0629"
          },
          "requires_approval": {
            "type": "boolean",
            "default": false,
            "description": "\u0647\u0644 \u062a\u062a\u0637\u0644\u0628 \u0645\u0648\u0627\u0641\u0642\u0629 \u0644\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0644\u0644\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629"
          },
          "approval_from": {
            "type": "string",
            "enum": [
              "client",
              "engineer",
              "both",
              "none"
            ],
            "default": "none",
            "description": "\u0645\u0646 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0648\u0627\u0641\u0642"
          },
          "completion_tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean",
                  "default": false
                }
              }
            },
            "description": "\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0647\u0627\u0645 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 \u0644\u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u0645\u0631\u062d\u0644\u0629"
          },
          "estimated_duration_days": {
            "type": "number",
            "description": "\u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0645\u062a\u0648\u0642\u0639\u0629 \u0628\u0627\u0644\u0623\u064a\u0627\u0645"
          },
          "color": {
            "type": "string",
            "default": "slate",
            "description": "\u0644\u0648\u0646 \u0627\u0644\u0645\u0631\u062d\u0644\u0629"
          }
        }
      },
      "description": "\u0645\u0631\u0627\u062d\u0644 \u0633\u064a\u0631 \u0627\u0644\u0639\u0645\u0644"
    },
    "current_stage_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0633\u064a\u0631 \u0627\u0644\u0639\u0645\u0644 \u0646\u0634\u0637"
    },
    "is_template": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0647\u0648 \u0642\u0627\u0644\u0628 \u064a\u0645\u0643\u0646 \u0625\u0639\u0627\u062f\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647"
    },
    "stage_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "entered_at": {
            "type": "string",
            "format": "date-time"
          },
          "exited_at": {
            "type": "string",
            "format": "date-time"
          },
          "approved_by": {
            "type": "string"
          },
          "approval_notes": {
            "type": "string"
          }
        }
      },
      "description": "\u0633\u062c\u0644 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0628\u064a\u0646 \u0627\u0644\u0645\u0631\u0627\u062d\u0644"
    }
  },
  "required": [
    "project_id",
    "name",
    "stages"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.project_id": {
            "_filter": "Project",
            "read": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.project_id": {
            "_filter": "Project",
            "update": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
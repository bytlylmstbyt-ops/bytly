{
  "name": "QuoteTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0642\u0627\u0644\u0628"
    },
    "template_type": {
      "type": "string",
      "enum": [
        "quote",
        "project"
      ],
      "default": "quote",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0642\u0627\u0644\u0628: \u0639\u0631\u0636 \u0633\u0639\u0631 \u0623\u0648 \u0645\u0634\u0631\u0648\u0639"
    },
    "category": {
      "type": "string",
      "enum": [
        "interior",
        "architecture",
        "painting",
        "landscape",
        "furniture",
        "lighting",
        "general"
      ],
      "default": "general",
      "description": "\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0642\u0627\u0644\u0628"
    },
    "project_title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a"
    },
    "scope_of_work": {
      "type": "string",
      "description": "\u0646\u0637\u0627\u0642 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a"
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u062e\u0631\u062c\u0627\u062a/\u0627\u0644\u062a\u0633\u0644\u064a\u0645\u0627\u062a"
    },
    "estimated_budget": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0627\u0644\u062a\u0642\u062f\u064a\u0631\u064a\u0629 \u0628\u0627\u0644\u0631\u064a\u0627\u0644"
    },
    "estimated_duration_days": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0645\u0642\u062f\u0631\u0629 \u0628\u0627\u0644\u0623\u064a\u0627\u0645"
    },
    "terms_and_conditions": {
      "type": "string",
      "description": "\u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645"
    },
    "is_shared": {
      "type": "boolean",
      "default": false,
      "description": "\u0642\u0627\u0644\u0628 \u0645\u0634\u062a\u0631\u0643 \u0645\u062a\u0627\u062d \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0647\u0646\u062f\u0633\u064a\u0646"
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0645\u0631\u0627\u062a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0642\u0627\u0644\u0628"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u0648\u0635\u0641 \u0645\u0648\u062c\u0632 \u0644\u0644\u0642\u0627\u0644\u0628"
    }
  },
  "required": [
    "name",
    "template_type"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.is_shared": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
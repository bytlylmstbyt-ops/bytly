{
  "name": "Advertisement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0625\u0639\u0644\u0627\u0646"
    },
    "advertiser_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0639\u0644\u0646 \u0623\u0648 \u0627\u0644\u0634\u0631\u0643\u0629"
    },
    "image_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0635\u0648\u0631\u0629 \u0627\u0644\u0625\u0639\u0644\u0627\u0646"
    },
    "video_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0641\u064a\u062f\u064a\u0648 \u0627\u0644\u0625\u0639\u0644\u0627\u0646 (MP4 \u0623\u0648 GIF)"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "gif"
      ],
      "default": "image",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u064a"
    },
    "destination_url": {
      "type": "string",
      "description": "\u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u0630\u064a \u064a\u064f\u062d\u0648\u064e\u0651\u0644 \u0625\u0644\u064a\u0647 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0646\u062f \u0627\u0644\u0646\u0642\u0631"
    },
    "category": {
      "type": "string",
      "enum": [
        "engineering",
        "contracting",
        "decor",
        "building_materials",
        "furniture",
        "consulting_office",
        "concrete_supply",
        "electrical",
        "plumbing",
        "landscape"
      ],
      "description": "\u0642\u0637\u0627\u0639 \u0627\u0644\u0625\u0639\u0644\u0627\u0646"
    },
    "target_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0648\u0633\u0648\u0645 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u0629 \u0644\u0644\u0645\u0637\u0627\u0628\u0642\u0629 \u0627\u0644\u0633\u064a\u0627\u0642\u064a\u0629"
    },
    "placement": {
      "type": "string",
      "enum": [
        "project_details",
        "engineer_dashboard",
        "projects_feed",
        "both",
        "all"
      ],
      "default": "all",
      "description": "\u0645\u0648\u0636\u0639 \u0638\u0647\u0648\u0631 \u0627\u0644\u0625\u0639\u0644\u0627\u0646"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0627\u0644\u0625\u0639\u0644\u0627\u0646 \u0646\u0634\u0637"
    },
    "is_verified_advertiser": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u0639\u0644\u0646 \u0645\u0639\u062a\u0645\u062f - \u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062b\u0642\u0629 \u0627\u0644\u0632\u0631\u0642\u0627\u0621"
    },
    "clicks": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0646\u0642\u0631\u0627\u062a"
    },
    "impressions": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0645\u0631\u0627\u062a \u0627\u0644\u0638\u0647\u0648\u0631"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0625\u0639\u0644\u0627\u0646"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0625\u0639\u0644\u0627\u0646"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0645\u062e\u062a\u0635\u0631 \u0644\u0644\u0625\u0639\u0644\u0627\u0646"
    },
    "logo_url": {
      "type": "string",
      "description": "\u0634\u0639\u0627\u0631 \u0627\u0644\u0645\u0639\u0644\u0646 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    }
  },
  "required": [
    "title",
    "advertiser_name",
    "image_url",
    "destination_url",
    "category"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    }
  }
}
{
  "name": "AnalyticsDailyActiveUser",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0630\u064a \u062a\u0645 \u0641\u064a\u0647 \u0642\u064a\u0627\u0633 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0646\u0634\u0637\u064a\u0646"
    },
    "active_users": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0646\u0634\u0637\u064a\u0646 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u064a\u0648\u0645"
    },
    "new_users": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u062c\u062f\u062f \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u064a\u0648\u0645"
    },
    "sessions": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u062c\u0644\u0633\u0627\u062a \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u064a\u0648\u0645"
    },
    "page_views": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0645\u0634\u0627\u0647\u062f\u0627\u062a \u0627\u0644\u0635\u0641\u062d\u0627\u062a"
    },
    "property_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u062e\u0627\u0635\u064a\u0629 Google Analytics"
    },
    "property_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u062e\u0627\u0635\u064a\u0629 Google Analytics"
    }
  },
  "required": [
    "date",
    "active_users"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
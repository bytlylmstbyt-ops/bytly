{
  "name": "ChatbotFAQ",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "engineers",
        "clients",
        "platform",
        "general"
      ],
      "description": "\u0641\u0626\u0629 \u0627\u0644\u0633\u0624\u0627\u0644"
    },
    "question": {
      "type": "string",
      "description": "\u0627\u0644\u0633\u0624\u0627\u0644"
    },
    "answer": {
      "type": "string",
      "description": "\u0627\u0644\u0625\u062c\u0627\u0628\u0629"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0643\u0644\u0645\u0627\u062a \u0645\u0641\u062a\u0627\u062d\u064a\u0629 \u0644\u0644\u0628\u062d\u062b"
    },
    "reference_link": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0635\u0641\u062d\u0629 \u0645\u0631\u062a\u0628\u0637\u0629"
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0627\u0644\u0633\u0624\u0627\u0644 \u0646\u0634\u0637"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0625\u0636\u0627\u0641\u064a \u0644\u0644\u0633\u0624\u0627\u0644 \u0648\u0633\u064a\u0627\u0642\u0647",
      "maxLength": 1000
    }
  },
  "required": [
    "category",
    "question",
    "answer"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
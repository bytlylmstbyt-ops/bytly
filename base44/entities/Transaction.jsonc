{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "client",
        "engineer",
        "firm",
        "platform"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "type": {
      "type": "string",
      "enum": [
        "deposit",
        "withdrawal",
        "escrow_hold",
        "escrow_release",
        "commission",
        "refund",
        "withdrawal_request",
        "withdrawal_completed",
        "subscription",
        "payment"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629"
    },
    "amount": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a"
    },
    "commission_amount": {
      "type": "number",
      "default": 0,
      "description": "\u0642\u064a\u0645\u0629 \u0627\u0644\u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u0645\u062e\u0635\u0648\u0645\u0629"
    },
    "net_amount": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0635\u0627\u0641\u064a \u0628\u0639\u062f \u0627\u0644\u0639\u0645\u0648\u0644\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "cancelled",
        "held_in_escrow"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629"
    },
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "milestone_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629"
    },
    "reference_id": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0645\u0631\u062c\u0639 \u0645\u0646 \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "mada",
        "visa",
        "mastercard",
        "apple_pay",
        "stc_pay",
        "moyasar",
        "tap",
        "bank_transfer"
      ],
      "description": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "balance_before": {
      "type": "number",
      "description": "\u0627\u0644\u0631\u0635\u064a\u062f \u0642\u0628\u0644 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629"
    },
    "balance_after": {
      "type": "number",
      "description": "\u0627\u0644\u0631\u0635\u064a\u062f \u0628\u0639\u062f \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629"
    },
    "from_wallet": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062d\u0641\u0638\u0629 \u0627\u0644\u0645\u0635\u062f\u0631"
    },
    "to_wallet": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062d\u0641\u0638\u0629 \u0627\u0644\u0647\u062f\u0641"
    },
    "related_transaction_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 (\u0644\u0644\u0631\u062c\u0648\u0639 \u0648\u0627\u0644\u062a\u062a\u0628\u0639)"
    },
    "metadata": {
      "type": "object",
      "description": "\u0628\u064a\u0627\u0646\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629 (\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0646 \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062f\u0641\u0639\u060c \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0646\u0632\u0627\u0639\u060c \u0625\u0644\u062e)"
    }
  },
  "required": [
    "user_email",
    "type",
    "amount"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "BIMModel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0646\u0645\u0648\u0630\u062c"
    },
    "model_urn": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0641\u064a Autodesk (URN)"
    },
    "guid": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0640 metadata GUID"
    },
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0641\u064a ACC/BIM360"
    },
    "hub_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0640 Hub \u0641\u064a ACC"
    },
    "folder_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u062c\u0644\u062f \u0641\u064a BIM360"
    },
    "item_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0644\u0641 (item) \u0641\u064a BIM360"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "bim360"
      ],
      "default": "manual",
      "description": "\u0645\u0635\u062f\u0631 \u0627\u0644\u0646\u0645\u0648\u0630\u062c"
    },
    "bim360_version_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u062d\u0627\u0644\u064a \u0641\u064a BIM360"
    },
    "bim360_last_modified": {
      "type": "string",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0622\u062e\u0631 \u062a\u0639\u062f\u064a\u0644 \u0641\u064a BIM360"
    },
    "last_bim360_sync": {
      "type": "string",
      "format": "date-time",
      "description": "\u0622\u062e\u0631 \u0645\u0632\u0627\u0645\u0646\u0629"
    },
    "owner_engineer_id": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0627\u0644\u0645\u0627\u0644\u0643"
    },
    "investor_id": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631 \u0627\u0644\u0645\u0635\u0631\u062d \u0644\u0647"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0646\u0645\u0648\u0630\u062c"
    },
    "floor_level": {
      "type": "string",
      "description": "\u0627\u0644\u0637\u0627\u0628\u0642 \u0623\u0648 \u0627\u0644\u0645\u0633\u062a\u0648\u0649"
    },
    "building_type": {
      "type": "string",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0628\u0646\u0649"
    },
    "indexed_properties": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u0627\u0644\u062e\u0635\u0627\u0626\u0635 \u0627\u0644\u0645\u0641\u0647\u0631\u0633\u0629 \u0644\u0644\u0628\u062d\u062b \u0627\u0644\u0630\u0643\u064a"
    },
    "last_indexed": {
      "type": "string",
      "format": "date-time",
      "description": "\u0622\u062e\u0631 \u0641\u0647\u0631\u0633\u0629"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.owner_engineer_id": "{{user.id}}"
        },
        {
          "data.investor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "SurveyRequest",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "surveyor_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u0627\u062d \u0627\u0644\u0645\u0642\u0628\u0648\u0644 (null \u062d\u062a\u0649 \u0627\u0644\u0642\u0628\u0648\u0644)"
    },
    "surveyor_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u0627\u062d"
    },
    "surveyor_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u0627\u062d"
    },
    "latitude": {
      "type": "number",
      "description": "\u062e\u0637 \u0639\u0631\u0636 \u0645\u0648\u0642\u0639 \u0627\u0644\u0639\u0642\u0627\u0631"
    },
    "longitude": {
      "type": "number",
      "description": "\u062e\u0637 \u0637\u0648\u0644 \u0645\u0648\u0642\u0639 \u0627\u0644\u0639\u0642\u0627\u0631"
    },
    "address": {
      "type": "string",
      "description": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0646\u0635\u064a \u0644\u0644\u0639\u0642\u0627\u0631"
    },
    "property_area_sqm": {
      "type": "number",
      "description": "\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0642\u0627\u0631 \u0627\u0644\u062a\u0642\u0631\u064a\u0628\u064a\u0629 (\u0645\u00b2)"
    },
    "property_status": {
      "type": "string",
      "enum": [
        "vacant_land",
        "existing_building"
      ],
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0639\u0642\u0627\u0631: \u0623\u0631\u0636 \u0641\u0636\u0627\u0621 \u0623\u0648 \u0645\u0628\u0646\u0649 \u0642\u0627\u0626\u0645"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629 \u0645\u0646 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "broadcasted",
        "accepted",
        "in_progress",
        "submitted",
        "approved",
        "disbursed",
        "cancelled"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0637\u0644\u0628 \u0627\u0644\u0645\u0633\u062d"
    },
    "payout_amount": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062f\u0641\u0648\u0639 \u0644\u0644\u0645\u0633\u0627\u062d"
    },
    "platform_fee": {
      "type": "number",
      "description": "\u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u0645\u0646\u0635\u0629"
    },
    "total_charged": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u062e\u0635\u0648\u0645 \u0645\u0646 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "commission_rate": {
      "type": "number",
      "default": 15,
      "description": "\u0646\u0633\u0628\u0629 \u0627\u0644\u0639\u0645\u0648\u0644\u0629"
    },
    "escrow_transaction_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0645\u0639\u0627\u0645\u0644\u0629 \u0627\u0644\u0636\u0645\u0627\u0646"
    },
    "escrow_status": {
      "type": "string",
      "enum": [
        "none",
        "held",
        "released",
        "refunded"
      ],
      "default": "none",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0636\u0645\u0627\u0646 \u0627\u0644\u0645\u0627\u0644\u064a"
    },
    "matched_surveyors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "surveyor_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "distance_km": {
            "type": "number"
          },
          "notified": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "\u0627\u0644\u0645\u0633\u0627\u062d\u064a\u0646 \u0627\u0644\u0645\u062a\u0637\u0627\u0628\u0642\u064a\u0646 \u0645\u0639 \u0627\u0644\u0637\u0644\u0628"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0642\u0628\u0648\u0644 \u0627\u0644\u0645\u0633\u0627\u062d"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u0645\u062e\u0631\u062c\u0627\u062a"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "disbursed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0635\u0631\u0641 \u0627\u0644\u0645\u0628\u0644\u063a \u0644\u0644\u0645\u0633\u0627\u062d"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0637\u0644\u0628",
      "maxLength": 1000
    }
  },
  "required": [
    "client_email",
    "client_name",
    "latitude",
    "longitude",
    "property_area_sqm"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.surveyor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.surveyor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
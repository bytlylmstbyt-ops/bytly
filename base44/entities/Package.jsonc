{
  "name": "Package",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0628\u0627\u0642\u0629"
    },
    "name_en": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0628\u0627\u0642\u0629 \u0628\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0628\u0627\u0642\u0629"
    },
    "duration_type": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u062f\u0629: \u0634\u0647\u0631\u064a \u0623\u0648 \u0633\u0646\u0648\u064a"
    },
    "price": {
      "type": "number",
      "description": "\u0633\u0639\u0631 \u0627\u0644\u0628\u0627\u0642\u0629 \u0628\u0627\u0644\u0631\u064a\u0627\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0628\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0628\u0627\u0642\u0629"
    },
    "featured_profile": {
      "type": "boolean",
      "default": false,
      "description": "\u0625\u0628\u0631\u0627\u0632 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0641\u064a \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629"
    },
    "priority_listing": {
      "type": "boolean",
      "default": false,
      "description": "\u0638\u0647\u0648\u0631 \u0623\u0648\u0644\u0648\u064a\u0629 \u0641\u064a \u0646\u062a\u0627\u0626\u062c \u0627\u0644\u0628\u062d\u062b"
    },
    "unlimited_proposals": {
      "type": "boolean",
      "default": false,
      "description": "\u0639\u0631\u0648\u0636 \u063a\u064a\u0631 \u0645\u062d\u062f\u0648\u062f\u0629"
    },
    "badge_display": {
      "type": "boolean",
      "default": false,
      "description": "\u0639\u0631\u0636 \u0634\u0627\u0631\u0629 \u0645\u0645\u064a\u0632\u0629 \u0639\u0644\u0649 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a"
    },
    "analytics_access": {
      "type": "boolean",
      "default": false,
      "description": "\u0627\u0644\u0648\u0635\u0648\u0644 \u0644\u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a \u0645\u0641\u0635\u0644\u0629"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0627\u0644\u0628\u0627\u0642\u0629 \u0646\u0634\u0637\u0629"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0639\u0631\u0636"
    }
  },
  "required": [
    "name",
    "duration_type",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "LegalConsultant",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "lawyer_license_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u062a\u0631\u062e\u064a\u0635 \u0627\u0644\u0645\u062d\u0627\u0645\u0627\u0629"
    },
    "city": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "legal_specialization": {
      "type": "string",
      "description": "\u0627\u0644\u062a\u062e\u0635\u0635 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a"
    },
    "bio": {
      "type": "string",
      "description": "\u0646\u0628\u0630\u0629 \u062a\u0639\u0631\u064a\u0641\u064a\u0629"
    },
    "profile_image": {
      "type": "string",
      "description": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a"
    },
    "years_experience": {
      "type": "number",
      "description": "\u0633\u0646\u0648\u0627\u062a \u0627\u0644\u062e\u0628\u0631\u0629"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u0648\u062b\u0642"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062d\u0633\u0627\u0628"
    },
    "wallet_balance": {
      "type": "number",
      "default": 0,
      "description": "\u0631\u0635\u064a\u062f \u0645\u062d\u0641\u0638\u0629 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631"
    },
    "total_contracts_reviewed": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0639\u0642\u0648\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "total_disputes_resolved": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0646\u0632\u0627\u0639\u0627\u062a \u0627\u0644\u0645\u062d\u0644\u0648\u0644\u0629"
    },
    "terms_and_conditions": {
      "type": "object",
      "properties": {
        "confidentiality_clause": {
          "type": "string",
          "description": "\u0628\u0646\u062f \u0627\u0644\u0633\u0631\u064a\u0629 \u0648\u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629"
        },
        "responsibility_clause": {
          "type": "string",
          "description": "\u0628\u0646\u062f \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629"
        },
        "intellectual_property_clause": {
          "type": "string",
          "description": "\u0628\u0646\u062f \u062d\u0642\u0648\u0642 \u0627\u0644\u0645\u0644\u0643\u064a\u0629 \u0627\u0644\u0641\u0643\u0631\u064a\u0629"
        },
        "custom_terms": {
          "type": "string",
          "description": "\u0634\u0631\u0648\u0637 \u0645\u062e\u0635\u0635\u0629 \u0625\u0636\u0627\u0641\u064a\u0629"
        },
        "accepted": {
          "type": "boolean",
          "default": false,
          "description": "\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0639\u0644\u0649 \u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645"
        },
        "accepted_date": {
          "type": "string",
          "format": "date-time",
          "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629"
        }
      },
      "description": "\u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629"
    },
    "legal_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "template_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "upload_date": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "\u0642\u0627\u0644\u0628 \u0627\u0644\u0639\u0642\u0648\u062f \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0648\u0627\u0644\u0627\u062a\u0641\u0627\u0642\u064a\u0627\u062a"
    },
    "approved_templates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0645\u0639\u0631\u0641\u0627\u062a \u0627\u0644\u0642\u0648\u0627\u0644\u0628 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0625\u062f\u0627\u0631\u0629"
    }
  },
  "required": [
    "full_name",
    "email",
    "lawyer_license_number",
    "legal_specialization"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
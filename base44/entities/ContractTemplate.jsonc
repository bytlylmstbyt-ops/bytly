{
  "name": "ContractTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0642\u0627\u0644\u0628"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0642\u0627\u0644\u0628"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "project_start",
        "service_agreement",
        "custom"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0639\u0642\u062f"
    },
    "default_terms": {
      "type": "string",
      "description": "\u0627\u0644\u0634\u0631\u0648\u0637 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629"
    },
    "custom_clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clause_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "is_required": {
            "type": "boolean"
          },
          "is_editable": {
            "type": "boolean"
          },
          "order": {
            "type": "number"
          }
        }
      },
      "description": "\u0627\u0644\u0628\u0646\u0648\u062f \u0627\u0644\u0645\u062e\u0635\u0635\u0629 \u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "default_payment_terms": {
      "type": "string",
      "description": "\u0634\u0631\u0648\u0637 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0627\u0644\u0642\u0627\u0644\u0628 \u0646\u0634\u0637"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "\u0642\u0627\u0644\u0628 \u0627\u0641\u062a\u0631\u0627\u0636\u064a"
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0645\u0631\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645"
    }
  },
  "required": [
    "name",
    "contract_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
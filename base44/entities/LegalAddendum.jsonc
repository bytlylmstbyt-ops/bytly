{
  "name": "LegalAddendum",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0642\u062f"
    },
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "legal_consultant_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a"
    },
    "addendum_title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0644\u062d\u0642 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a"
    },
    "addendum_content": {
      "type": "string",
      "description": "\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u0644\u062d\u0642 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a"
    },
    "intellectual_property_clause": {
      "type": "string",
      "description": "\u0628\u0646\u062f \u062d\u0642\u0648\u0642 \u0627\u0644\u0645\u0644\u0643\u064a\u0629 \u0627\u0644\u0641\u0643\u0631\u064a\u0629"
    },
    "dispute_resolution_clause": {
      "type": "string",
      "description": "\u0628\u0646\u062f \u062d\u0644 \u0627\u0644\u0646\u0632\u0627\u0639\u0627\u062a"
    },
    "local_law_compliance": {
      "type": "string",
      "description": "\u0627\u0644\u062a\u0648\u0627\u0641\u0642 \u0645\u0639 \u0627\u0644\u0642\u0648\u0627\u0646\u064a\u0646 \u0627\u0644\u0645\u062d\u0644\u064a\u0629"
    },
    "addendum_file": {
      "type": "string",
      "description": "\u0645\u0644\u0641 \u0627\u0644\u0645\u0644\u062d\u0642 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a PDF"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "rejected"
      ],
      "default": "draft",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0644\u062d\u0642"
    },
    "client_acceptance": {
      "type": "boolean",
      "default": false,
      "description": "\u0642\u0628\u0648\u0644 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "engineer_acceptance": {
      "type": "boolean",
      "default": false,
      "description": "\u0642\u0628\u0648\u0644 \u0627\u0644\u0645\u0647\u0646\u062f\u0633"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0645\u0648\u062c\u0632 \u0644\u0644\u0645\u0644\u062d\u0642 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a \u0648\u0645\u0644\u062e\u0635 \u0627\u0644\u0642\u0636\u064a\u0629",
      "maxLength": 1000
    }
  },
  "required": [
    "contract_id",
    "legal_consultant_id",
    "addendum_title"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    }
  }
}
{
  "name": "NotificationSettings",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "notification_preferences": {
      "type": "object",
      "properties": {
        "project_updates": {
          "type": "boolean",
          "default": true,
          "description": "\u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639"
        },
        "contract_updates": {
          "type": "boolean",
          "default": true,
          "description": "\u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0627\u0644\u0639\u0642\u0648\u062f"
        },
        "payment_reminders": {
          "type": "boolean",
          "default": true,
          "description": "\u062a\u0630\u0643\u064a\u0631\u0627\u062a \u0627\u0644\u062f\u0641\u0639"
        },
        "milestone_reminders": {
          "type": "boolean",
          "default": true,
          "description": "\u062a\u0630\u0643\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0639\u0627\u0644\u0645"
        },
        "new_proposals": {
          "type": "boolean",
          "default": true,
          "description": "\u0639\u0631\u0648\u0636 \u062c\u062f\u064a\u062f\u0629"
        },
        "deadline_reminders": {
          "type": "boolean",
          "default": true,
          "description": "\u062a\u0630\u0643\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f"
        },
        "system_notifications": {
          "type": "boolean",
          "default": true,
          "description": "\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645"
        },
        "dispute_updates": {
          "type": "boolean",
          "default": true,
          "description": "\u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0627\u0644\u0646\u0632\u0627\u0639\u0627\u062a"
        },
        "new_messages": {
          "type": "boolean",
          "default": true,
          "description": "\u0631\u0633\u0627\u0626\u0644 \u062c\u062f\u064a\u062f\u0629"
        },
        "review_requests": {
          "type": "boolean",
          "default": true,
          "description": "\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062a\u0642\u064a\u064a\u0645"
        }
      },
      "description": "\u062a\u0641\u0636\u064a\u0644\u0627\u062a \u0627\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a"
    },
    "email_notifications": {
      "type": "boolean",
      "default": true,
      "description": "\u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "in_app_notifications": {
      "type": "boolean",
      "default": true,
      "description": "\u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642"
    },
    "reminder_timing": {
      "type": "object",
      "properties": {
        "before_deadline_days": {
          "type": "number",
          "default": 3
        },
        "payment_reminder_days": {
          "type": "number",
          "default": 5
        }
      },
      "description": "\u062a\u0648\u0642\u064a\u062a \u0627\u0644\u062a\u0630\u0643\u064a\u0631\u0627\u062a"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u062a\u0641\u0636\u064a\u0644\u0627\u062a \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645",
      "maxLength": 1000
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
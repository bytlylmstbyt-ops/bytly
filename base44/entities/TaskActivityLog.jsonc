{
  "name": "TaskActivityLog",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "task_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0647\u0645\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629"
    },
    "task_title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0647\u0645\u0629 \u0648\u0642\u062a \u0627\u0644\u062a\u0633\u062c\u064a\u0644 (\u0644\u0644\u0639\u0631\u0636 \u0627\u0644\u0633\u0631\u064a\u0639)"
    },
    "actor_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0630\u064a \u0642\u0627\u0645 \u0628\u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "actor_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0630\u064a \u0642\u0627\u0645 \u0628\u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "created",
        "updated",
        "status_changed",
        "deleted"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0625\u062c\u0631\u0627\u0621: \u0625\u0646\u0634\u0627\u0621\u060c \u062a\u0639\u062f\u064a\u0644\u060c \u062a\u063a\u064a\u064a\u0631 \u062d\u0627\u0644\u0629\u060c \u062d\u0630\u0641"
    },
    "field_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u062d\u0642\u0644 \u0627\u0644\u0630\u064a \u062a\u063a\u064a\u0651\u0631 (\u0644\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0627\u0644\u062c\u0632\u0626\u064a\u0629)"
    },
    "old_value": {
      "type": "string",
      "description": "\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0642\u062f\u064a\u0645\u0629"
    },
    "new_value": {
      "type": "string",
      "description": "\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629"
    },
    "summary": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0645\u062e\u062a\u0635\u0631 \u0644\u0644\u062a\u0639\u062f\u064a\u0644 \u0628\u0644\u063a\u0629 \u0645\u0641\u0647\u0648\u0645\u0629 \u0644\u0644\u0639\u0645\u064a\u0644 \u0648\u0627\u0644\u0645\u0647\u0646\u062f\u0633"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u0648\u0635\u0641 \u062a\u0641\u0635\u064a\u0644\u064a \u0644\u0644\u0646\u0634\u0627\u0637 \u0648\u0633\u064a\u0627\u0642\u0647"
    }
  },
  "required": [
    "project_id",
    "task_id",
    "actor_email",
    "action_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.actor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0642\u0627\u0644\u0628"
    },
    "subject": {
      "type": "string",
      "description": "\u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "body": {
      "type": "string",
      "description": "\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0642\u0627\u0644\u0628 (\u064a\u062f\u0639\u0645 HTML \u0648\u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0645\u062b\u0644 {{user_name}})"
    },
    "category": {
      "type": "string",
      "enum": [
        "welcome",
        "notification",
        "marketing",
        "transactional",
        "reminder",
        "system",
        "other"
      ],
      "default": "other",
      "description": "\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0642\u0627\u0644\u0628"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u062f\u0639\u0648\u0645\u0629 \u0641\u064a \u0627\u0644\u0642\u0627\u0644\u0628"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0627\u0644\u0642\u0627\u0644\u0628 \u0646\u0634\u0637"
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0645\u0631\u0627\u062a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0642\u0627\u0644\u0628"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u0648\u0635\u0641 \u0645\u062e\u062a\u0635\u0631 \u0644\u0644\u0642\u0627\u0644\u0628"
    }
  },
  "required": [
    "name",
    "subject",
    "body"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
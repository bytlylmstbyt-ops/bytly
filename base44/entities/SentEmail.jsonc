{
  "name": "SentEmail",
  "type": "object",
  "properties": {
    "to_email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0645\u0633\u062a\u0644\u0645"
    },
    "recipient_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u0644\u0645"
    },
    "subject": {
      "type": "string",
      "description": "\u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0628\u0631\u064a\u062f"
    },
    "body": {
      "type": "string",
      "description": "\u0646\u0635 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "source": {
      "type": "string",
      "description": "\u0645\u0635\u062f\u0631 \u0627\u0644\u0625\u0631\u0633\u0627\u0644: \u0627\u0633\u0645 \u0627\u0644\u062f\u0627\u0644\u0629 \u0623\u0648 \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0630\u064a \u0623\u0631\u0633\u0644 \u0627\u0644\u0628\u0631\u064a\u062f"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0648\u0648\u0642\u062a \u0627\u0644\u0625\u0631\u0633\u0627\u0644"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed"
      ],
      "default": "sent",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0625\u0631\u0633\u0627\u0644"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0645\u062e\u062a\u0635\u0631 \u0644\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0631\u0633\u0644 \u0648\u0633\u064a\u0627\u0642\u0647",
      "maxLength": 1000
    }
  },
  "required": [
    "to_email",
    "subject",
    "body"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
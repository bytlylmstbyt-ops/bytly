{
  "name": "Portfolio",
  "type": "object",
  "properties": {
    "engineer_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0647\u0646\u062f\u0633"
    },
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0639\u0645\u0644"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0639\u0645\u0644"
    },
    "category": {
      "type": "string",
      "enum": [
        "interior",
        "architecture",
        "painting",
        "landscape",
        "furniture",
        "lighting",
        "civil_engineering",
        "structural_design",
        "executive_drawing"
      ],
      "description": "\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0639\u0645\u0644"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0635\u0648\u0631 \u0627\u0644\u0639\u0645\u0644"
    },
    "project_type": {
      "type": "string",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "location": {
      "type": "string",
      "description": "\u0645\u0648\u0642\u0639 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "year": {
      "type": "number",
      "description": "\u0633\u0646\u0629 \u0627\u0644\u062a\u0646\u0641\u064a\u0630"
    },
    "budget": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0629 (\u0628\u0627\u0644\u0631\u064a\u0627\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a)"
    },
    "duration_days": {
      "type": "number",
      "description": "\u0645\u062f\u0629 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0628\u0627\u0644\u0623\u064a\u0627\u0645"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0628\u062f\u0621 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "completion_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0645\u0631\u062a\u0628\u0637 (\u0625\u0646 \u0648\u062c\u062f)"
    },
    "certification_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0634\u0647\u0627\u062f\u0629 \u0627\u0644\u062c\u0648\u062f\u0629 \u0644\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "has_certification": {
      "type": "boolean",
      "default": false,
      "description": "\u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0634\u0647\u0627\u062f\u0629 \u062c\u0648\u062f\u0629"
    },
    "client_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "team_size": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0641\u0631\u064a\u0642"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0648\u0633\u0648\u0645 \u0627\u0644\u0628\u062d\u062b"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u0645\u064a\u0632"
    }
  },
  "required": [
    "engineer_id",
    "title"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.engineer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.engineer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
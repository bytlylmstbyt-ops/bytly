{
  "name": "ProjectRevision",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "revision_number": {
      "type": "number",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "requested_by": {
      "type": "string",
      "description": "\u0645\u0646 \u0637\u0644\u0628 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0645\u0631\u0641\u0642\u0627\u062a \u0627\u0644\u062a\u0648\u0636\u064a\u062d"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "engineer_response": {
      "type": "string",
      "description": "\u0631\u062f \u0627\u0644\u0645\u0647\u0646\u062f\u0633"
    },
    "completion_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0625\u0646\u062c\u0627\u0632 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    }
  },
  "required": [
    "project_id",
    "revision_number",
    "description"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.requested_by": "{{user.email}}"
        },
        {
          "data.project_id": {
            "_filter": "Project",
            "read": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.project_id": {
            "_filter": "Project",
            "update": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
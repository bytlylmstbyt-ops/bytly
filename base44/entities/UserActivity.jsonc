    },
    "user_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0622\u062e\u0631 \u0646\u0634\u0627\u0637 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "current_page": {
      "type": "string",
      "description": "\u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {

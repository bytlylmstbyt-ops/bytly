{
  "name": "AutomationRunLog",
  "properties": {
    "duration_ms": {
      "description": "\u0645\u062f\u0629 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0628\u0627\u0644\u0645\u0644\u0644\u064a \u062b\u0627\u0646\u064a\u0629",
      "type": "number"
    },
    "ended_at": {
      "description": "\u0648\u0642\u062a \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621",
      "format": "date-time",
      "type": "string"
    },
    "error_message": {
      "description": "\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u062e\u0637\u0623 \u0625\u0646 \u0641\u0634\u0644 \u0627\u0644\u062a\u0646\u0641\u064a\u0630",
      "type": "string"
    },
    "related_entity_id": {
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0643\u064a\u0627\u0646 \u0627\u0644\u0630\u064a \u0633\u0628\u0651\u0628 \u0627\u0644\u062a\u0634\u063a\u064a\u0644",
      "type": "string"
    },
    "related_entity_type": {
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0643\u064a\u0627\u0646 \u0627\u0644\u0630\u064a \u0633\u0628\u0651\u0628 \u0627\u0644\u062a\u0634\u063a\u064a\u0644",
      "type": "string"
    },
    "rule_id": {
      "description": "\u0645\u0639\u0631\u0641 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0623\u062a\u0645\u062a\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629",
      "type": "string"
    },
    "rule_name": {
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0648\u0642\u062a \u0627\u0644\u062a\u0646\u0641\u064a\u0630 (\u0644\u0644\u0639\u0631\u0636 \u0627\u0644\u0633\u0631\u064a\u0639)",
      "type": "string"
    },
    "started_at": {
      "description": "\u0648\u0642\u062a \u0627\u0644\u0628\u062f\u0621",
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "running",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u0646\u0641\u064a\u0630",
      "enum": [
        "running",
        "success",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "steps_log": {
      "description": "\u0633\u062c\u0644 \u0627\u0644\u062e\u0637\u0648\u0627\u062a \u0627\u0644\u0645\u0646\u0641\u0630\u0629",
      "items": {
        "properties": {
          "action_type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "enum": [
              "success",
              "failed",
              "skipped"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "triggered_by": {
      "description": "\u0645\u0635\u062f\u0631 \u0627\u0644\u062a\u0634\u063a\u064a\u0644",
      "enum": [
        "system_event",
        "schedule",
        "manual_test"
      ],
      "type": "string"
    },
    "triggered_by_email": {
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0634\u0631\u0641 \u0627\u0644\u0630\u064a \u0634\u063a\u0651\u0644 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u064a\u062f\u0648\u064a\u064b\u0627 (\u0625\u0646 \u0648\u062c\u062f)",
      "type": "string"
    }
  },
  "required": [
    "rule_id",
    "rule_name",
    "status",
    "triggered_by",
    "started_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}
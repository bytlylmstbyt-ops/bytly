{
  "name": "MarketEntity",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u062c\u0647\u0629 (\u0627\u0644\u0645\u0637\u0648\u0631/\u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631)"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "developer",
        "investor"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062c\u0647\u0629: \u0645\u0637\u0648\u0631 \u0639\u0642\u0627\u0631\u064a \u0623\u0648 \u0645\u0633\u062a\u062b\u0645\u0631"
    },
    "contact_person": {
      "type": "string",
      "description": "\u0634\u062e\u0635 \u0627\u0644\u062a\u0648\u0627\u0635\u0644"
    },
    "email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "region": {
      "type": "string",
      "enum": [
        "\u0627\u0644\u0631\u064a\u0627\u0636",
        "\u062c\u062f\u0629",
        "\u0627\u0644\u062f\u0645\u0627\u0645",
        "\u0645\u0643\u0629",
        "\u0627\u0644\u0645\u062f\u064a\u0646\u0629",
        "\u0623\u0628\u0647\u0627",
        "\u062a\u0628\u0648\u0643",
        "\u062d\u0627\u0626\u0644",
        "\u0627\u0644\u062c\u0648\u0641",
        "\u0627\u0644\u0642\u0635\u064a\u0645",
        "\u0639\u0633\u064a\u0631",
        "\u062c\u0627\u0632\u0627\u0646",
        "\u0646\u062c\u0631\u0627\u0646",
        "\u0627\u0644\u0628\u0627\u062d\u0629",
        "\u0627\u0644\u062d\u062f\u0648\u062f \u0627\u0644\u0634\u0645\u0627\u0644\u064a\u0629",
        "\u0634\u0631\u0648\u0631\u0629"
      ],
      "description": "\u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a\u0629"
    },
    "project_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "\u0633\u0643\u0646\u064a",
          "\u062a\u062c\u0627\u0631\u064a",
          "\u0635\u0646\u0627\u0639\u064a",
          "\u062a\u0631\u0641\u064a\u0647\u064a",
          "\u062a\u0639\u0644\u064a\u0645\u064a",
          "\u0635\u062d\u064a",
          "\u0645\u062e\u062a\u0644\u0637"
        ]
      },
      "description": "\u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0645\u0647\u062a\u0645 \u0628\u0647\u0627"
    },
    "investment_range": {
      "type": "string",
      "enum": [
        "\u0623\u0642\u0644 \u0645\u0646 1 \u0645\u0644\u064a\u0648\u0646",
        "1-5 \u0645\u0644\u064a\u0648\u0646",
        "5-10 \u0645\u0644\u064a\u0648\u0646",
        "10-50 \u0645\u0644\u064a\u0648\u0646",
        "50-100 \u0645\u0644\u064a\u0648\u0646",
        "\u0623\u0643\u062b\u0631 \u0645\u0646 100 \u0645\u0644\u064a\u0648\u0646"
      ],
      "description": "\u0646\u0637\u0627\u0642 \u062d\u062c\u0645 \u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631"
    },
    "description": {
      "type": "string",
      "description": "\u0646\u0628\u0630\u0629 \u0639\u0646 \u0627\u0644\u062c\u0647\u0629",
      "maxLength": 1000
    },
    "website": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "logo_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0634\u0639\u0627\u0631"
    },
    "completed_projects": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0645\u0646\u062c\u0632\u0629"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u062c\u0647\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062c\u0647\u0629"
    },
    "social_links": {
      "type": "object",
      "properties": {
        "linkedin": {
          "type": "string"
        },
        "twitter": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        }
      },
      "description": "\u0631\u0648\u0627\u0628\u0637 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a"
    }
  },
  "required": [
    "name",
    "entity_type",
    "email",
    "region"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.status": "active"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}